From 146de7ebd6ed0c34845753ad329fec89f68508ab Mon Sep 17 00:00:00 2001
From: Michiel Bruijn <michiel@bruijn.nu>
Date: Sun, 27 Sep 2026 08:44:40 +0200
Subject: [PATCH 34/49] ncrypt: Support importing legacy CAPI RSA key blobs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016s12iuoTmYVZJQsft4SbDV
---
 dlls/ncrypt/main.c            | 65 +++++++++++++++++++++++++++++++++++
 dlls/ncrypt/tests/Makefile.in |  2 +-
 dlls/ncrypt/tests/ncrypt.c    | 53 ++++++++++++++++++++++++++++
 3 files changed, 119 insertions(+), 1 deletion(-)

diff --git a/dlls/ncrypt/main.c b/dlls/ncrypt/main.c
index ad18435..f960a07 100644
--- a/dlls/ncrypt/main.c
+++ b/dlls/ncrypt/main.c
@@ -503,6 +503,32 @@ SECURITY_STATUS WINAPI NCryptGetProperty(NCRYPT_HANDLE handle, const WCHAR *name
     return ERROR_SUCCESS;
 }
 
+/* bcrypt doesn't import LEGACY_RSAPUBLIC_BLOB, convert it to a BCRYPT_RSAPUBLIC_BLOB */
+static BCRYPT_RSAKEY_BLOB *legacy_to_rsa_public_blob(const BLOBHEADER *hdr, DWORD size, DWORD *ret_size)
+{
+    const RSAPUBKEY *rsakey = (const RSAPUBKEY *)(hdr + 1);
+    const BYTE *modulus = (const BYTE *)(rsakey + 1);
+    DWORD mod_len = rsakey->bitlen / 8, exp = rsakey->pubexp, exp_len = 0, i;
+    BCRYPT_RSAKEY_BLOB *blob;
+    BYTE *ptr;
+
+    if (rsakey->magic != 0x31415352 /* RSA1 */ || size < sizeof(*hdr) + sizeof(*rsakey) + mod_len) return NULL;
+    for (i = exp; i; i >>= 8) exp_len++;
+    if (!(blob = malloc(sizeof(*blob) + exp_len + mod_len))) return NULL;
+
+    blob->Magic = BCRYPT_RSAPUBLIC_MAGIC;
+    blob->BitLength = rsakey->bitlen;
+    blob->cbPublicExp = exp_len;
+    blob->cbModulus = mod_len;
+    blob->cbPrime1 = blob->cbPrime2 = 0;
+    ptr = (BYTE *)(blob + 1);
+    /* the legacy format stores numbers in little-endian order */
+    for (i = 0; i < exp_len; i++) ptr[i] = exp >> ((exp_len - 1 - i) * 8);
+    for (i = 0; i < mod_len; i++) ptr[exp_len + i] = modulus[mod_len - 1 - i];
+    *ret_size = sizeof(*blob) + exp_len + mod_len;
+    return blob;
+}
+
 SECURITY_STATUS WINAPI NCryptImportKey(NCRYPT_PROV_HANDLE provider, NCRYPT_KEY_HANDLE decrypt_key,
                                        const WCHAR *type, NCryptBufferDesc *params, NCRYPT_KEY_HANDLE *handle,
                                        BYTE *data, DWORD datasize, DWORD flags)
@@ -561,6 +587,45 @@ SECURITY_STATUS WINAPI NCryptImportKey(NCRYPT_PROV_HANDLE provider, NCRYPT_KEY_H
         set_object_property(object, BCRYPT_PUBLIC_KEY_LENGTH, (BYTE *)&rsablob->BitLength, sizeof(rsablob->BitLength));
         break;
     }
+    case (PUBLICKEYBLOB | CUR_BLOB_VERSION << 8):
+    case (PRIVATEKEYBLOB | CUR_BLOB_VERSION << 8):
+    {
+        const BLOBHEADER *hdr = (const BLOBHEADER *)data;
+        const RSAPUBKEY *rsakey = (const RSAPUBKEY *)(hdr + 1);
+        BCRYPT_RSAKEY_BLOB *pub = NULL;
+        NTSTATUS status;
+
+        if (datasize < sizeof(*hdr) + sizeof(*rsakey) || (hdr->aiKeyAlg != CALG_RSA_KEYX && hdr->aiKeyAlg != CALG_RSA_SIGN))
+        {
+            FIXME("Unhandled legacy key blob, alg %#x\n", hdr->aiKeyAlg);
+            return NTE_INVALID_PARAMETER;
+        }
+        if (!(object = create_key_object(RSA, provider)))
+        {
+            ERR("Error allocating memory\n");
+            return NTE_NO_MEMORY;
+        }
+
+        if (hdr->bType == PRIVATEKEYBLOB)
+            status = BCryptImportKeyPair(BCRYPT_RSA_ALG_HANDLE, NULL, LEGACY_RSAPRIVATE_BLOB,
+                                         &object->key.bcrypt_key, data, datasize, 0);
+        else if (!(pub = legacy_to_rsa_public_blob(hdr, datasize, &datasize)))
+            status = STATUS_INVALID_PARAMETER;
+        else
+            status = BCryptImportKeyPair(BCRYPT_RSA_ALG_HANDLE, NULL, BCRYPT_RSAPUBLIC_BLOB,
+                                         &object->key.bcrypt_key, (UCHAR *)pub, datasize, 0);
+        free(pub);
+        if (status != STATUS_SUCCESS)
+        {
+            WARN("Error importing legacy key pair %#lx\n", status);
+            free(object);
+            return map_ntstatus(status);
+        }
+
+        set_object_property(object, NCRYPT_LENGTH_PROPERTY, (BYTE *)&rsakey->bitlen, sizeof(rsakey->bitlen));
+        set_object_property(object, BCRYPT_PUBLIC_KEY_LENGTH, (BYTE *)&rsakey->bitlen, sizeof(rsakey->bitlen));
+        break;
+    }
     default:
         FIXME("Unhandled key magic %#lx\n", header->Magic);
         return NTE_INVALID_PARAMETER;
diff --git a/dlls/ncrypt/tests/Makefile.in b/dlls/ncrypt/tests/Makefile.in
index 9f0b4b1..551f687 100644
--- a/dlls/ncrypt/tests/Makefile.in
+++ b/dlls/ncrypt/tests/Makefile.in
@@ -1,5 +1,5 @@
 TESTDLL   = ncrypt.dll
-IMPORTS   = ncrypt
+IMPORTS   = ncrypt bcrypt
 
 SOURCES = \
 	ncrypt.c
diff --git a/dlls/ncrypt/tests/ncrypt.c b/dlls/ncrypt/tests/ncrypt.c
index 25df547..e4a407d 100644
--- a/dlls/ncrypt/tests/ncrypt.c
+++ b/dlls/ncrypt/tests/ncrypt.c
@@ -899,6 +899,58 @@ static void test_named_persisted_key(void)
     NCryptFreeObject(prov);
 }
 
+static void test_legacy_key_import(void)
+{
+    BYTE blob[1024], blob2[1024], legacy[1024];
+    BCRYPT_ALG_HANDLE alg;
+    BCRYPT_KEY_HANDLE bkey;
+    NCRYPT_PROV_HANDLE prov;
+    NCRYPT_KEY_HANDLE key;
+    SECURITY_STATUS ret;
+    ULONG size, size2, legacy_size;
+    NTSTATUS status;
+
+    status = BCryptOpenAlgorithmProvider(&alg, BCRYPT_RSA_ALGORITHM, NULL, 0);
+    ok(!status, "got %#lx\n", status);
+    status = BCryptGenerateKeyPair(alg, &bkey, 1024, 0);
+    ok(!status, "got %#lx\n", status);
+    status = BCryptFinalizeKeyPair(bkey, 0);
+    ok(!status, "got %#lx\n", status);
+    status = BCryptExportKey(bkey, NULL, BCRYPT_RSAPUBLIC_BLOB, blob, sizeof(blob), &size, 0);
+    ok(!status, "got %#lx\n", status);
+
+    ret = NCryptOpenStorageProvider(&prov, NULL, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+
+    status = BCryptExportKey(bkey, NULL, LEGACY_RSAPUBLIC_BLOB, legacy, sizeof(legacy), &legacy_size, 0);
+    ok(!status, "got %#lx\n", status);
+    ret = NCryptImportKey(prov, 0, LEGACY_RSAPUBLIC_BLOB, NULL, &key, legacy, legacy_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    if (ret == ERROR_SUCCESS)
+    {
+        ret = NCryptExportKey(key, 0, BCRYPT_RSAPUBLIC_BLOB, NULL, blob2, sizeof(blob2), &size2, 0);
+        ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+        ok(size2 == size && !memcmp(blob, blob2, size), "public keys differ\n");
+        NCryptFreeObject(key);
+    }
+
+    status = BCryptExportKey(bkey, NULL, LEGACY_RSAPRIVATE_BLOB, legacy, sizeof(legacy), &legacy_size, 0);
+    ok(!status, "got %#lx\n", status);
+    ret = NCryptImportKey(prov, 0, LEGACY_RSAPRIVATE_BLOB, NULL, &key, legacy, legacy_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    if (ret == ERROR_SUCCESS)
+    {
+        ret = NCryptExportKey(key, 0, BCRYPT_RSAPUBLIC_BLOB, NULL, blob2, sizeof(blob2), &size2, 0);
+        ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+        ok(size2 == size && !memcmp(blob, blob2, size), "public keys differ\n");
+        NCryptFreeObject(key);
+    }
+
+    NCryptFreeObject(prov);
+    BCryptDestroyKey(bkey);
+    BCryptCloseAlgorithmProvider(alg, 0);
+}
+
 START_TEST(ncrypt)
 {
     test_key_import_rsa();
@@ -913,4 +965,5 @@ START_TEST(ncrypt)
     test_NCryptExportKey();
     test_NCryptIsKeyHandle();
     test_named_persisted_key();
+    test_legacy_key_import();
 }
