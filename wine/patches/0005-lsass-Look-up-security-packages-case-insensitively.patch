From 53e69f013e16b15c3682b29dfe81c3f2ecc629fb Mon Sep 17 00:00:00 2001
From: Michiel Bruijn <michiel@bruijn.nu>
Date: Sun, 27 Sep 2026 08:40:27 +0200
Subject: [PATCH 05/49] lsass: Look up security packages case-insensitively.

Applications pass package names like "negotiate" or "ntlm" in lower case,
which Windows accepts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016s12iuoTmYVZJQsft4SbDV
---
 dlls/secur32/tests/ntlm.c | 19 +++++++++++++++++++
 programs/lsass/lsass.c    |  2 +-
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/dlls/secur32/tests/ntlm.c b/dlls/secur32/tests/ntlm.c
index d7c926d..3646e20 100644
--- a/dlls/secur32/tests/ntlm.c
+++ b/dlls/secur32/tests/ntlm.c
@@ -1651,6 +1651,24 @@ static void test_null_auth_data(void)
     HeapFree(GetProcessHeap(), 0, buffers[0].pvBuffer);
 }
 
+static void test_lowercase_package_name(void)
+{
+    CredHandle cred;
+    TimeStamp expiry;
+    SECURITY_STATUS status;
+
+    /* package names are case insensitive */
+    status = AcquireCredentialsHandleA(NULL, (SEC_CHAR *)"ntlm", SECPKG_CRED_OUTBOUND, NULL, NULL, NULL, NULL,
+                                       &cred, &expiry);
+    ok(status == SEC_E_OK, "got %#lx\n", status);
+    if (status == SEC_E_OK) FreeCredentialsHandle(&cred);
+
+    status = AcquireCredentialsHandleA(NULL, (SEC_CHAR *)"negotiate", SECPKG_CRED_OUTBOUND, NULL, NULL, NULL, NULL,
+                                       &cred, &expiry);
+    ok(status == SEC_E_OK, "got %#lx\n", status);
+    if (status == SEC_E_OK) FreeCredentialsHandle(&cred);
+}
+
 START_TEST(ntlm)
 {
     testAcquireCredentialsHandleW();
@@ -1665,4 +1683,5 @@ START_TEST(ntlm)
     test_Encrypt();
     test_cred_multiple_use();
     test_null_auth_data();
+    test_lowercase_package_name();
 }
diff --git a/programs/lsass/lsass.c b/programs/lsass/lsass.c
index c73a75e..1e9e84d 100644
--- a/programs/lsass/lsass.c
+++ b/programs/lsass/lsass.c
@@ -96,7 +96,7 @@ static struct package * lsa_lookup_package( const WCHAR *name )
 
     for (i = 0; i < packages_count; i++)
     {
-        if (!wcscmp( packages[i].info.Name, name ))
+        if (!wcsicmp( packages[i].info.Name, name ))
             return packages + i;
     }
     return NULL;
-- 
