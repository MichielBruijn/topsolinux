+/**********************************************************************
+ *           RtlGetImageFileMachines  (NTDLL.@)
+ */
+NTSTATUS WINAPI RtlGetImageFileMachines( const WCHAR *filename, USHORT *machines )
+{
+    IMAGE_DOS_HEADER dos;
+    struct
+    {
+        DWORD signature;
+        IMAGE_FILE_HEADER file;
+    } nt;
+    UNICODE_STRING nt_name;
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK io;
+    LARGE_INTEGER offset;
+    NTSTATUS status;
+    HANDLE file;
+
+    if ((status = RtlDosPathNameToNtPathName_U_WithStatus( filename, &nt_name, NULL, NULL ))) return status;
+    InitializeObjectAttributes( &attr, &nt_name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    status = NtOpenFile( &file, GENERIC_READ | SYNCHRONIZE, &attr, &io, FILE_SHARE_READ | FILE_SHARE_DELETE,
+                         FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE );
+    RtlFreeUnicodeString( &nt_name );
+    if (status) return status;
+
+    offset.QuadPart = 0;
+    status = NtReadFile( file, 0, NULL, NULL, &io, &dos, sizeof(dos), &offset, NULL );
+    if (!status && (io.Information != sizeof(dos) || dos.e_magic != IMAGE_DOS_SIGNATURE))
+        status = STATUS_INVALID_IMAGE_NOT_MZ;
+    if (!status)
+    {
+        offset.QuadPart = dos.e_lfanew;
+        status = NtReadFile( file, 0, NULL, NULL, &io, &nt, sizeof(nt), &offset, NULL );
+        if (!status && (io.Information != sizeof(nt) || nt.signature != IMAGE_NT_SIGNATURE))
+            status = STATUS_INVALID_IMAGE_FORMAT;
+    }
+    NtClose( file );
+    if (status) return status;
+
+    switch (nt.file.Machine)
+    {
+    case IMAGE_FILE_MACHINE_I386:  *machines = 0x1; break;
+    case IMAGE_FILE_MACHINE_AMD64: *machines = 0x2; break;
+    case IMAGE_FILE_MACHINE_ARMNT: *machines = 0x4; break;
+    case IMAGE_FILE_MACHINE_ARM64: *machines = 0x8; break;
+    default: return STATUS_INVALID_IMAGE_FORMAT;
+    }
+    return STATUS_SUCCESS;
+}
+
