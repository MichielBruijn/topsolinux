--- a/dlls/ntdll/tests/rtl.c
+++ b/dlls/ntdll/tests/rtl.c
@@ -5562,6 +5562,61 @@ static void test_pointer_encoding(void)
     ok( v == expected, "got %p, expected %p.\n", v, expected );
 }
 
+static void test_RtlGetImageFileMachines(void)
+{
+    NTSTATUS (WINAPI *pRtlGetImageFileMachines)(const WCHAR *, USHORT *);
+    WCHAR path[MAX_PATH];
+    USHORT machines, expect;
+    NTSTATUS status;
+    HANDLE file;
+    DWORD size;
+
+    pRtlGetImageFileMachines = (void *)GetProcAddress( hntdll, "RtlGetImageFileMachines" );
+    if (!pRtlGetImageFileMachines)
+    {
+        win_skip( "RtlGetImageFileMachines is not available\n" );
+        return;
+    }
+
+#if defined(__i386__)
+    expect = 0x1;
+#elif defined(__x86_64__)
+    expect = 0x2;
+#elif defined(__arm__)
+    expect = 0x4;
+#else
+    expect = 0x8;
+#endif
+
+    GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) );
+    machines = 0xdead;
+    status = pRtlGetImageFileMachines( path, &machines );
+    ok( !status, "got %#lx\n", status );
+    ok( machines == expect, "got %#x, expected %#x\n", machines, expect );
+
+    wcscpy( path, L"\\??\\" );
+    GetModuleFileNameW( NULL, path + 4, ARRAY_SIZE(path) - 4 );
+    machines = 0xdead;
+    status = pRtlGetImageFileMachines( path, &machines );
+    ok( !status, "got %#lx\n", status );
+    ok( machines == expect, "got %#x, expected %#x\n", machines, expect );
+
+    status = pRtlGetImageFileMachines( L"%SystemRoot%\\system32\\kernel32.dll", &machines );
+    ok( status == STATUS_OBJECT_PATH_NOT_FOUND, "got %#lx\n", status );
+
+    GetTempPathW( ARRAY_SIZE(path), path );
+    wcscat( path, L"machines.txt" );
+    file = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    ok( file != INVALID_HANDLE_VALUE, "failed to create %s, error %lu\n", debugstr_w(path), GetLastError() );
+    WriteFile( file, "not an image", 12, &size, NULL );
+    CloseHandle( file );
+    status = pRtlGetImageFileMachines( path, &machines );
+    ok( status == STATUS_INVALID_IMAGE_NOT_MZ, "got %#lx\n", status );
+    DeleteFileW( path );
+    status = pRtlGetImageFileMachines( path, &machines );
+    ok( status == STATUS_OBJECT_NAME_NOT_FOUND, "got %#lx\n", status );
+}
+
 START_TEST(rtl)
 {
     InitFunctionPtrs();
@@ -5634,4 +5689,5 @@ START_TEST(rtl)
     test_RtlCreateServiceSid();
     test_RtlDeriveCapabilitySidsFromName();
     test_pointer_encoding();
+    test_RtlGetImageFileMachines();
 }
