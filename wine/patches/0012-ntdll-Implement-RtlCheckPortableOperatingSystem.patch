diff --git a/dlls/ntdll/tests/rtl.c b/dlls/ntdll/tests/rtl.c
index 35daabb..da46ccd 100644
--- a/dlls/ntdll/tests/rtl.c
+++ b/dlls/ntdll/tests/rtl.c
@@ -5617,6 +5617,27 @@ static void test_RtlGetImageFileMachines(void)
     ok( status == STATUS_OBJECT_NAME_NOT_FOUND, "got %#lx\n", status );
 }
 
+static void test_RtlCheckPortableOperatingSystem(void)
+{
+    NTSTATUS (WINAPI *pRtlCheckPortableOperatingSystem)(BOOLEAN *);
+    NTSTATUS status;
+    BOOLEAN portable;
+
+    pRtlCheckPortableOperatingSystem = (void *)GetProcAddress( hntdll, "RtlCheckPortableOperatingSystem" );
+    if (!pRtlCheckPortableOperatingSystem)
+    {
+        win_skip( "RtlCheckPortableOperatingSystem is not available\n" );
+        return;
+    }
+
+    portable = 0xcc;
+    status = pRtlCheckPortableOperatingSystem( &portable );
+    /* the registry value normally doesn't exist */
+    ok( status == STATUS_NOT_FOUND || !status, "got %#lx\n", status );
+    if (status) ok( portable == 0xcc, "got %u\n", portable );
+    else ok( !portable, "got %u\n", portable );
+}
+
