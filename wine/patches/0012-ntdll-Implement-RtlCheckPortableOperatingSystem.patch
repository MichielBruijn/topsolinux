+/**********************************************************************
+ *           RtlCheckPortableOperatingSystem  (NTDLL.@)
+ */
+NTSTATUS WINAPI RtlCheckPortableOperatingSystem( BOOLEAN *portable )
+{
+    static const WCHAR controlW[] = L"\\Registry\\Machine\\System\\CurrentControlSet\\Control";
+    char buffer[offsetof( KEY_VALUE_PARTIAL_INFORMATION, Data[sizeof(DWORD)] )];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    UNICODE_STRING name = RTL_CONSTANT_STRING( controlW ), value = RTL_CONSTANT_STRING( L"PortableOperatingSystem" );
+    OBJECT_ATTRIBUTES attr;
+    NTSTATUS status;
+    HANDLE key;
+    DWORD size;
+
+    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if ((status = NtOpenKey( &key, KEY_QUERY_VALUE, &attr ))) return STATUS_NOT_FOUND;
+    status = NtQueryValueKey( key, &value, KeyValuePartialInformation, buffer, sizeof(buffer), &size );
+    NtClose( key );
+    if (status || info->Type != REG_DWORD || info->DataLength != sizeof(DWORD)) return STATUS_NOT_FOUND;
+    if (!portable) return STATUS_INVALID_PARAMETER;
+    *portable = !!*(DWORD *)info->Data;
+    return STATUS_SUCCESS;
+}
+
+
