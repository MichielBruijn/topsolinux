From 7ea04861b2bfb6d8d4e1c0691ec2d909a22c1b8c Mon Sep 17 00:00:00 2001
From: Michiel Bruijn <michiel@bruijn.nu>
Date: Mon, 5 Oct 2026 12:08:18 +0200
Subject: [PATCH 52/53] wbemprox: Use the free-threaded marshaler for the WMI
 objects.

They can be used from any thread. .NET hands them to other apartments through standard marshaling,
which failed with E_NOINTERFACE.
---
 dlls/wbemprox/class.c            | 10 ++++++++++
 dlls/wbemprox/main.c             | 15 +++++++++++++++
 dlls/wbemprox/qualifier.c        |  5 +++++
 dlls/wbemprox/services.c         | 10 ++++++++++
 dlls/wbemprox/wbemlocator.c      |  5 +++++
 dlls/wbemprox/wbemprox_private.h |  1 +
 6 files changed, 46 insertions(+)

diff --git a/dlls/wbemprox/class.c b/dlls/wbemprox/class.c
index 009cfed..d191b41 100644
--- a/dlls/wbemprox/class.c
+++ b/dlls/wbemprox/class.c
@@ -34,6 +34,7 @@ struct enum_class_object
 {
     IEnumWbemClassObject IEnumWbemClassObject_iface;
     LONG refs;
+    IUnknown *marshal;
     struct query *query;
     UINT index;
     enum wbm_namespace ns;
@@ -61,6 +62,7 @@ static ULONG WINAPI enum_class_object_Release(
     {
         TRACE("destroying %p\n", ec);
         release_query( ec->query );
+        if (ec->marshal) IUnknown_Release( ec->marshal );
         free( ec );
     }
     return refs;
@@ -86,6 +88,8 @@ static HRESULT WINAPI enum_class_object_QueryInterface(
         *ppvObject = &client_security;
         return S_OK;
     }
+    else if ( IsEqualGUID( riid, &IID_IMarshal ) )
+        return get_marshal( (IUnknown *)iface, &ec->marshal, riid, ppvObject );
     else
     {
         FIXME("interface %s not implemented\n", debugstr_guid(riid));
@@ -210,6 +214,7 @@ HRESULT EnumWbemClassObject_create( struct query *query, LPVOID *ppObj )
 
     ec->IEnumWbemClassObject_iface.lpVtbl = &enum_class_object_vtbl;
     ec->refs  = 1;
+    ec->marshal = NULL;
     ec->query = addref_query( query );
     ec->index = 0;
     ec->ns = query->ns;
@@ -275,6 +280,7 @@ struct class_object
 {
     IWbemClassObject IWbemClassObject_iface;
     LONG refs;
+    IUnknown *marshal;
     WCHAR *name;
     IEnumWbemClassObject *iter;
     LONG flags;
@@ -309,6 +315,7 @@ static ULONG WINAPI class_object_Release(
         if (co->iter) IEnumWbemClassObject_Release( co->iter );
         destroy_record( co->record );
         free( co->name );
+        if (co->marshal) IUnknown_Release( co->marshal );
         free( co );
     }
     return refs;
@@ -334,6 +341,8 @@ static HRESULT WINAPI class_object_QueryInterface(
         *ppvObject = &client_security;
         return S_OK;
     }
+    else if ( IsEqualGUID( riid, &IID_IMarshal ) )
+        return get_marshal( (IUnknown *)iface, &co->marshal, riid, ppvObject );
     else
     {
         FIXME("interface %s not implemented\n", debugstr_guid(riid));
@@ -1097,6 +1106,7 @@ HRESULT create_class_object( enum wbm_namespace ns, const WCHAR *name, IEnumWbem
 
     co->IWbemClassObject_iface.lpVtbl = &class_object_vtbl;
     co->refs  = 1;
+    co->marshal = NULL;
     if (!name) co->name = NULL;
     else if (!(co->name = wcsdup( name )))
     {
diff --git a/dlls/wbemprox/main.c b/dlls/wbemprox/main.c
index 97f859b..dcd0c8a 100644
--- a/dlls/wbemprox/main.c
+++ b/dlls/wbemprox/main.c
@@ -140,3 +140,18 @@ HRESULT WINAPI DllGetClassObject( REFCLSID rclsid, REFIID iid, LPVOID *ppv )
     if (!cf) return CLASS_E_CLASSNOTAVAILABLE;
     return IClassFactory_QueryInterface( cf, iid, ppv );
 }
+
+/* The objects can be used from any thread: the free-threaded marshaler hands them to another
+ * apartment as they are. Wine has no proxies for the WMI interfaces. */
+HRESULT get_marshal( IUnknown *outer, IUnknown **marshal, REFIID riid, void **obj )
+{
+    IUnknown *unk;
+    HRESULT hr;
+
+    if (!*marshal)
+    {
+        if (FAILED(hr = CoCreateFreeThreadedMarshaler( outer, &unk ))) return hr;
+        if (InterlockedCompareExchangePointer( (void **)marshal, unk, NULL )) IUnknown_Release( unk );
+    }
+    return IUnknown_QueryInterface( *marshal, riid, obj );
+}
diff --git a/dlls/wbemprox/qualifier.c b/dlls/wbemprox/qualifier.c
index 2ca5aaf..61e8c14 100644
--- a/dlls/wbemprox/qualifier.c
+++ b/dlls/wbemprox/qualifier.c
@@ -34,6 +34,7 @@ struct qualifier_set
 {
     IWbemQualifierSet IWbemQualifierSet_iface;
     LONG refs;
+    IUnknown *marshal;
     enum wbm_namespace ns;
     WCHAR *class;
     WCHAR *member;
@@ -62,6 +63,7 @@ static ULONG WINAPI qualifier_set_Release(
         TRACE("destroying %p\n", set);
         free( set->class );
         free( set->member );
+        if (set->marshal) IUnknown_Release( set->marshal );
         free( set );
     }
     return refs;
@@ -82,6 +84,8 @@ static HRESULT WINAPI qualifier_set_QueryInterface(
     {
         *ppvObject = &set->IWbemQualifierSet_iface;
     }
+    else if ( IsEqualGUID( riid, &IID_IMarshal ) )
+        return get_marshal( (IUnknown *)iface, &set->marshal, riid, ppvObject );
     else
     {
         FIXME("interface %s not implemented\n", debugstr_guid(riid));
@@ -297,6 +301,7 @@ HRESULT WbemQualifierSet_create( enum wbm_namespace ns, const WCHAR *class, cons
     }
     set->ns = ns;
     set->refs = 1;
+    set->marshal = NULL;
 
     *ppObj = &set->IWbemQualifierSet_iface;
 
