 };
 
@@ -1050,6 +1056,8 @@ static HRESULT WINAPI wbem_context_QueryInterface(
     {
         *obj = iface;
     }
+    else if ( IsEqualGUID( riid, &IID_IMarshal ) )
+        return get_marshal( (IUnknown *)iface, &impl_from_IWbemContext( iface )->marshal, riid, obj );
     else
     {
         FIXME("interface %s not implemented\n", debugstr_guid(riid));
@@ -1077,6 +1085,7 @@ static ULONG WINAPI wbem_context_Release(
     {
         TRACE("destroying %p\n", context);
         wbem_context_delete_values( context );
+        if (context->marshal) IUnknown_Release( context->marshal );
         free( context );
     }
     return refs;
@@ -1274,6 +1283,7 @@ HRESULT WbemContext_create( void **obj, REFIID riid )
 
     context->IWbemContext_iface.lpVtbl = &wbem_context_vtbl;
     context->refs = 1;
+    context->marshal = NULL;
     list_init(&context->values);
 
     *obj = &context->IWbemContext_iface;
