From 1eb8927236cc790a570135c492347cfa37cc551c Mon Sep 17 00:00:00 2001
From: Michiel Bruijn <michiel@bruijn.nu>
Date: Sun, 11 Oct 2026 23:09:06 +0200
Subject: [PATCH 68/68] winex11.drv: Don't take an unchanged _NET_WM_STATE as
 the answer to a request.

Mutter rewrites _NET_WM_STATE when a window gets focus, for _NET_WM_STATE_FOCUSED which we
don't track. Arriving after our request to remove _NET_WM_STATE_ABOVE, it was taken as the
window manager refusing it and the window stayed above: a TopSolid panel pulled out of the
main window (shown topmost, then made not topmost) sometimes stayed on top of other
applications. Only for states a window manager doesn't refuse.
---
 dlls/winex11.drv/window.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 926e09d3952..7e82b9e6306 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -1910,14 +1910,20 @@ void window_net_wm_state_notify( struct x11drv_win_data *data, unsigned long ser
 {
     UINT *desired = &data->desired_state.net_wm_state, *pending = &data->pending_state.net_wm_state, *current = &data->current_state.net_wm_state;
     unsigned long *expect_serial = &data->net_wm_state_serial;
-    const char *expected, *received, *prefix;
+    const UINT never_refused = (1 << KDE_NET_WM_STATE_SKIP_SWITCHER) | (1 << NET_WM_STATE_ABOVE) |
+                               (1 << NET_WM_STATE_SKIP_PAGER) | (1 << NET_WM_STATE_SKIP_TASKBAR);
+    const char *reason = NULL, *expected, *received, *prefix;
 
     prefix = wine_dbg_sprintf( "window %p/%lx ", data->hwnd, data->whole_window );
     received = wine_dbg_sprintf( "_NET_WM_STATE %#x/%lu", value, serial );
     expected = *expect_serial ? wine_dbg_sprintf( ", expected %#x/%lu", *pending, *expect_serial ) : "";
+    /* the WM also rewrites the property for states we don't track (Mutter's _NET_WM_STATE_FOCUSED),
+     * an unchanged value isn't the answer to a request for a state the WM doesn't refuse */
+    if (*expect_serial && value == *current && value != *pending && !((value ^ *pending) & ~never_refused))
+        reason = "unrelated ";
 
     if (!handle_state_change( serial, expect_serial, sizeof(value), &value, desired, pending,
-                              current, expected, prefix, received, NULL ))
+                              current, expected, prefix, received, reason ))
         return;
 
     /* send any pending changes from the desired state */
