+enum spnav_event_type
+{
+    SPNAV_EVENT_NONE = -1,
+    SPNAV_EVENT_MOTION = 0,
+    SPNAV_EVENT_BUTTON_PRESS = 1,
+    SPNAV_EVENT_BUTTON_RELEASE = 2,
