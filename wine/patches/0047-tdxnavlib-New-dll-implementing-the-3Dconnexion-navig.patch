new file mode 100644
index 0000000..cf0d461
--- /dev/null
+++ b/dlls/tdxnavlib/unixlib.c
@@ -0,0 +1,117 @@
+/*
+ * 3Dconnexion navigation library replacement backed by spacenavd
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <poll.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "ntstatus.h"
+#include "windef.h"
+#include "winternl.h"
+#include "wine/debug.h"
+
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(tdxnavlib);
+
+static int spnav_fd = -1;
+
+static NTSTATUS spnav_open( void *args )
+{
+    const char *path = getenv( "SPNAV_SOCKET" );
+    struct sockaddr_un addr = { .sun_family = AF_UNIX };
+    int fd;
+
+    if (spnav_fd != -1) return STATUS_SUCCESS;
+    if (!path) path = "/run/spnav.sock";
+    if (strlen( path ) >= sizeof(addr.sun_path)) return STATUS_INVALID_PARAMETER;
+    strcpy( addr.sun_path, path );
+
+    if ((fd = socket( AF_UNIX, SOCK_STREAM, 0 )) == -1) return STATUS_UNSUCCESSFUL;
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ) == -1)
+    {
+        TRACE( "cannot connect to %s: %s\n", path, strerror( errno ) );
+        close( fd );
+        return STATUS_DEVICE_NOT_CONNECTED;
+    }
+    TRACE( "connected to %s\n", path );
+    spnav_fd = fd;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS spnav_close( void *args )
+{
+    if (spnav_fd != -1) close( spnav_fd );
+    spnav_fd = -1;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS spnav_read( void *args )
+{
+    struct spnav_read_params *params = args;
+    struct pollfd pfd;
+    size_t done = 0;
+    ssize_t ret;
+
+    params->data[0] = SPNAV_EVENT_NONE;
+    if (spnav_fd == -1) return STATUS_DEVICE_NOT_CONNECTED;
+
+    pfd.fd = spnav_fd;
+    pfd.events = POLLIN;
+    if ((ret = poll( &pfd, 1, params->timeout )) <= 0) return ret ? STATUS_UNSUCCESSFUL : STATUS_TIMEOUT;
+
+    /* spacenavd protocol v0 sends events as 8 native ints */
+    while (done < sizeof(params->data))
+    {
+        ret = read( spnav_fd, (char *)params->data + done, sizeof(params->data) - done );
+        if (ret <= 0)
+        {
+            if (ret < 0 && errno == EINTR) continue;
+            spnav_close( NULL );
+            params->data[0] = SPNAV_EVENT_NONE;
+            return STATUS_DEVICE_NOT_CONNECTED;
+        }
+        done += ret;
+    }
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    spnav_open,
+    spnav_close,
+    spnav_read,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+/* struct spnav_read_params has the same layout on 32-bit */
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    spnav_open,
+    spnav_close,
+    spnav_read,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif /* _WIN64 */
