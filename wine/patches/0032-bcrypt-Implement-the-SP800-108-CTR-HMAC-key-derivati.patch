 dlls/bcrypt/tests/bcrypt.c | 41 +++++++++++++++++++++++++++++++
 include/bcrypt.h           |  2 ++
 3 files changed, 91 insertions(+), 1 deletion(-)

diff --git a/dlls/bcrypt/bcrypt_main.c b/dlls/bcrypt/bcrypt_main.c
index d0ee3b7..4e7b8b8 100644
--- a/dlls/bcrypt/bcrypt_main.c
