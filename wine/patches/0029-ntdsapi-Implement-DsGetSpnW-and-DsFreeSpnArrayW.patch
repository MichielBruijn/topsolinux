diff --git a/dlls/ntdsapi/tests/ntdsapi.c b/dlls/ntdsapi/tests/ntdsapi.c
index d2a5934..fb96939 100644
--- a/dlls/ntdsapi/tests/ntdsapi.c
+++ b/dlls/ntdsapi/tests/ntdsapi.c
@@ -178,8 +178,47 @@ static void test_DsClientMakeSpnForTargetServer(void)
     ok( !lstrcmpW( buf, resultW ), "wrong data\n" );
 }
 
+static void test_DsGetSpn(void)
+{
+    WCHAR name[MAX_COMPUTERNAME_LENGTH + 1], expect[64];
+    DWORD ret, count, size;
+    WCHAR **spns;
+
+    size = ARRAY_SIZE(name);
+    GetComputerNameExW(ComputerNameNetBIOS, name, &size);
+
+    count = 0xdeadbeef;
+    spns = NULL;
+    ret = DsGetSpnW(DS_SPN_NB_HOST, L"MSSQLSvc", NULL, 1433, 0, NULL, NULL, &count, &spns);
+    ok(!ret, "got %lu\n", ret);
+    ok(count == 1, "got %lu\n", count);
+    swprintf(expect, ARRAY_SIZE(expect), L"MSSQLSvc/%s:1433", name);
+    ok(!wcsicmp(spns[0], expect), "got %s, expected %s\n", wine_dbgstr_w(spns[0]), wine_dbgstr_w(expect));
+    DsFreeSpnArrayW(count, spns);
+
+    ret = DsGetSpnW(DS_SPN_DNS_HOST, L"MSSQLSvc", NULL, 0, 0, NULL, NULL, &count, &spns);
+    ok(!ret, "got %lu\n", ret);
+    ok(count == 1, "got %lu\n", count);
+    ok(!wcsnicmp(spns[0], L"MSSQLSvc/", 9) && !wcschr(spns[0] + 9, ':'), "got %s\n", wine_dbgstr_w(spns[0]));
+    DsFreeSpnArrayW(count, spns);
+
+    /* host SPNs don't take a service name */
+    count = 0xdeadbeef;
+    ret = DsGetSpnW(DS_SPN_DNS_HOST, L"MSSQLSvc", L"host.example.com", 1433, 0, NULL, NULL, &count, &spns);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ok(count == 0xdeadbeef, "got %lu\n", count);
+
+    /* service SPNs need one */
+    ret = DsGetSpnW(DS_SPN_SERVICE, L"MSSQLSvc", NULL, 1433, 0, NULL, NULL, &count, &spns);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+
+    ret = DsGetSpnW(DS_SPN_DNS_HOST, NULL, NULL, 1433, 0, NULL, NULL, &count, &spns);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+}
+
 START_TEST( ntdsapi )
 {
     test_DsMakeSpn();
     test_DsClientMakeSpnForTargetServer();
+    test_DsGetSpn();
 }
