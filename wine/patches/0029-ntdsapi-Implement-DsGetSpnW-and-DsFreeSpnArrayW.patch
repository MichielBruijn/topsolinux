 dlls/ntdsapi/ntdsapi.spec    |  4 +-
 dlls/ntdsapi/tests/ntdsapi.c | 39 +++++++++++++++++++
 include/ntdsapi.h            |  3 ++
 4 files changed, 118 insertions(+), 2 deletions(-)

diff --git a/dlls/ntdsapi/ntdsapi.c b/dlls/ntdsapi/ntdsapi.c
index be8689f..e438f06 100644
--- a/dlls/ntdsapi/ntdsapi.c
+++ b/dlls/ntdsapi/ntdsapi.c
@@ -229,6 +229,80 @@ DWORD WINAPI DsGetSpnA(DS_SPN_NAME_TYPE ServType, LPCSTR Servlass, LPCSTR ServNa
     return ERROR_CALL_NOT_IMPLEMENTED;
 }
 
+/***********************************************************************
+ *             DsGetSpnW (NTDSAPI.@)
+ */
+DWORD WINAPI DsGetSpnW(DS_SPN_NAME_TYPE type, LPCWSTR svc_class, LPCWSTR svc_name, USHORT inst_port,
+                       USHORT inst_count, LPCWSTR *inst_names, const USHORT *inst_ports,
+                       DWORD *spn_count, LPWSTR **spn_array)
+{
+    WCHAR host[256];
+    DWORD host_len = ARRAY_SIZE(host), count, i, size, len, ret;
+    LPWSTR *array, str;
+
+    TRACE("(%d,%s,%s,%d,%d,%p,%p,%p,%p)\n", type, debugstr_w(svc_class), debugstr_w(svc_name), inst_port,
+          inst_count, inst_names, inst_ports, spn_count, spn_array);
+
+    if (!svc_class || !spn_count || !spn_array) return ERROR_INVALID_PARAMETER;
+
+    switch (type)
+    {
+    case DS_SPN_DNS_HOST:
+    case DS_SPN_DN_HOST:
+    case DS_SPN_NB_HOST:
+        /* host SPNs are built from the name of the local computer */
+        if (svc_name) return ERROR_INVALID_PARAMETER;
+        if (!GetComputerNameExW(type == DS_SPN_NB_HOST ? ComputerNameNetBIOS : ComputerNameDnsFullyQualified,
+                                host, &host_len))
+            return GetLastError();
+        svc_name = host;
+        break;
+    default:
+        if (!svc_name) return ERROR_INVALID_PARAMETER;
+        break;
+    }
+
+    count = inst_count ? inst_count : 1;
+
+    /* first pass computes the size, second pass fills in the strings */
+    size = count * sizeof(LPWSTR);
+    for (i = 0; i < count; i++)
+    {
+        len = 0;
+        DsMakeSpnW(svc_class, svc_name, inst_count ? inst_names[i] : NULL,
+                   inst_count ? (inst_ports ? inst_ports[i] : 0) : inst_port, NULL, &len, NULL);
+        size += len * sizeof(WCHAR);
+    }
+
+    if (!(array = HeapAlloc(GetProcessHeap(), 0, size))) return ERROR_NOT_ENOUGH_MEMORY;
+    str = (LPWSTR)(array + count);
+    for (i = 0; i < count; i++)
+    {
+        len = (size - ((BYTE *)str - (BYTE *)array)) / sizeof(WCHAR);
+        if ((ret = DsMakeSpnW(svc_class, svc_name, inst_count ? inst_names[i] : NULL,
+                              inst_count ? (inst_ports ? inst_ports[i] : 0) : inst_port, NULL, &len, str)))
+        {
+            HeapFree(GetProcessHeap(), 0, array);
+            return ret;
+        }
+        array[i] = str;
+        str += len;
+    }
+
+    *spn_count = count;
+    *spn_array = array;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *             DsFreeSpnArrayW (NTDSAPI.@)
+ */
+void WINAPI DsFreeSpnArrayW(DWORD count, LPWSTR *array)
+{
+    TRACE("(%ld,%p)\n", count, array);
+    HeapFree(GetProcessHeap(), 0, array);
+}
