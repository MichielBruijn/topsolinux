diff --git a/dlls/ncrypt/tests/ncrypt.c b/dlls/ncrypt/tests/ncrypt.c
index 53da3dc..25df547 100644
--- a/dlls/ncrypt/tests/ncrypt.c
+++ b/dlls/ncrypt/tests/ncrypt.c
@@ -20,6 +20,7 @@
 #include <stdarg.h>
 #include <windef.h>
 #include <winbase.h>
+#include <wincrypt.h>
 #include <ncrypt.h>
 #include <bcrypt.h>
 
@@ -840,6 +841,64 @@ static void test_NCryptExportKey(void)
     NCryptFreeObject(prov);
 }
 
+static void test_NCryptIsKeyHandle(void)
+{
+    NCRYPT_PROV_HANDLE prov;
+    NCRYPT_KEY_HANDLE key;
+    SECURITY_STATUS ret;
+
+    ok(!NCryptIsKeyHandle(0), "expected FALSE\n");
+
+    ret = NCryptOpenStorageProvider(&prov, NULL, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(!NCryptIsKeyHandle(prov), "expected FALSE for a provider handle\n");
+
+    ret = NCryptCreatePersistedKey(prov, &key, BCRYPT_RSA_ALGORITHM, NULL, 0, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(NCryptIsKeyHandle(key), "expected TRUE for a key handle\n");
+
+    NCryptFreeObject(key);
+    NCryptFreeObject(prov);
+}
+
+static void test_named_persisted_key(void)
+{
+    static const WCHAR name[] = L"wine_test_ncrypt_persisted_key";
+    BYTE blob[1024], blob2[1024];
+    NCRYPT_PROV_HANDLE prov;
+    NCRYPT_KEY_HANDLE key, key2;
+    SECURITY_STATUS ret;
+    DWORD size, size2;
+
+    ret = NCryptOpenStorageProvider(&prov, NULL, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+
+    ret = NCryptCreatePersistedKey(prov, &key, BCRYPT_RSA_ALGORITHM, name, 0, NCRYPT_OVERWRITE_KEY_FLAG);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptFinalizeKey(key, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptExportKey(key, 0, BCRYPT_RSAPUBLIC_BLOB, NULL, blob, sizeof(blob), &size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    NCryptFreeObject(key);
+
+    ret = NCryptOpenKey(prov, &key2, name, 0, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    if (ret == ERROR_SUCCESS)
+    {
+        ret = NCryptExportKey(key2, 0, BCRYPT_RSAPUBLIC_BLOB, NULL, blob2, sizeof(blob2), &size2, 0);
+        ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+        ok(size2 == size && !memcmp(blob, blob2, size), "keys differ\n");
+
+        ret = NCryptDeleteKey(key2, 0);
+        ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    }
+
+    ret = NCryptOpenKey(prov, &key2, name, 0, 0);
+    ok(ret == NTE_BAD_KEYSET, "got %#lx\n", ret);
+
+    NCryptFreeObject(prov);
+}
+
 START_TEST(ncrypt)
 {
     test_key_import_rsa();
@@ -852,4 +911,6 @@ START_TEST(ncrypt)
     test_NCryptIsAlgSupported();
     test_NCryptEncrypt();
     test_NCryptExportKey();
+    test_NCryptIsKeyHandle();
+    test_named_persisted_key();
 }
