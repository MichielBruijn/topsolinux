     struct
     {
         unsigned int seq_no;
@@ -1605,6 +1607,7 @@ static NTSTATUS NTAPI ntlm_SpInitLsaModeContext( LSA_SEC_HANDLE cred_handle, LSA
         data->mode = ctx->mode;
         data->flags = ctx->flags;
         memcpy( data->session_key, ctx->session_key, sizeof(data->session_key) );
+        data->token = 0;
 
         *mapped_ctx = TRUE;
         ctx_data->cbBuffer = sizeof( *data );
@@ -1632,6 +1635,25 @@ done:
     return status;
 }
 
+static HANDLE dup_token_to_client( HANDLE token )
+{
+    SECPKG_CALL_INFO info;
+    HANDLE process, ret = NULL;
+
+    if (!token || !lsa_secpkg_table->GetCallInfo( &info )) return NULL;
+    if (info.Attributes & SECPKG_CALL_IN_PROC || info.ProcessId == GetCurrentProcessId())
+        process = GetCurrentProcess();
+    else if (!(process = OpenProcess( PROCESS_DUP_HANDLE, FALSE, info.ProcessId )))
+    {
+        WARN( "failed to open client process %lu\n", info.ProcessId );
+        return NULL;
+    }
+    if (!DuplicateHandle( GetCurrentProcess(), token, process, &ret, 0, FALSE, DUPLICATE_SAME_ACCESS ))
+        ret = NULL;
+    if (process != GetCurrentProcess()) CloseHandle( process );
+    return ret;
+}
+
 static NTSTATUS NTAPI ntlm_SpAcceptLsaModeContext( LSA_SEC_HANDLE cred_handle, LSA_SEC_HANDLE ctx_handle,
                                                    SecBufferDesc *input, ULONG ctx_req, ULONG data_rep,
                                                    LSA_SEC_HANDLE *new_ctx_handle, SecBufferDesc *output,
@@ -1830,8 +1852,8 @@ static NTSTATUS NTAPI ntlm_SpAcceptLsaModeContext( LSA_SEC_HANDLE cred_handle, L
                 memset( ctx->session_key, 0, sizeof(ctx->session_key) );
                 goto done;
             }
-            /* FIXME: Use the token in QuerySecurityContextToken */
-            CloseHandle( token );
+            CloseHandle( ctx->token );
+            ctx->token = token;
 
             memcpy( mic_client, authenticate->mic, sizeof(authenticate->mic) );
             memset( authenticate->mic, 0, sizeof(authenticate->mic) );
@@ -1931,6 +1953,7 @@ done:
             data->mode = ctx->mode;
             data->flags = ctx->flags;
             memcpy( data->session_key, ctx->session_key, sizeof(data->session_key) );
+            data->token = (ULONG_PTR)dup_token_to_client( ctx->token );
 
             *mapped_ctx = TRUE;
             ctx_data->cbBuffer = sizeof( *data );
@@ -2304,10 +2327,12 @@ static NTSTATUS NTAPI ntlm_SpInitUserModeContext( LSA_SEC_HANDLE handle, SecBuff
         }
         list_add_head( &user_ctx_list, &ctx->entry );
     }
+    else if (ctx->token) CloseHandle( ctx->token );
 
     ctx->handle = handle;
     ctx->mode = data->mode;
     ctx->flags = data->flags;
+    ctx->token = (HANDLE)(ULONG_PTR)data->token;
 
     arc4_init( &ctx->ntlm.arc4info, data->session_key, 16 );
     ctx->ntlm.seq_no = 0;
@@ -2610,12 +2635,34 @@ static NTSTATUS NTAPI ntlm_SpDeleteUserModeContext( LSA_SEC_HANDLE handle )
     if (user_ctx)
     {
         list_remove( &user_ctx->entry );
+        if (user_ctx->token) CloseHandle( user_ctx->token );
         free( user_ctx );
     }
     LeaveCriticalSection( &user_ctx_cs );
     return STATUS_SUCCESS;
 }
 
+static NTSTATUS NTAPI ntlm_SpGetContextToken( LSA_SEC_HANDLE handle, HANDLE *token )
+{
+    struct user_ctx *user_ctx;
+    NTSTATUS status = SEC_E_INVALID_HANDLE;
+
+    TRACE( "%Ix, %p\n", handle, token );
+
+    EnterCriticalSection( &user_ctx_cs );
+    if ((user_ctx = find_user_ctx( handle )))
+    {
+        if (user_ctx->token)
+        {
+            *token = user_ctx->token;
+            status = SEC_E_OK;
+        }
+        else status = SEC_E_NO_IMPERSONATION;
+    }
+    LeaveCriticalSection( &user_ctx_cs );
+    return status;
+}
+
 static SECPKG_USER_FUNCTION_TABLE ntlm_user_table =
 {
     ntlm_SpInstanceInit,
@@ -2624,7 +2671,7 @@ static SECPKG_USER_FUNCTION_TABLE ntlm_user_table =
     ntlm_SpVerifySignature,
     ntlm_SpSealMessage,
     ntlm_SpUnsealMessage,
-    NULL, /* SpGetContextToken */
+    ntlm_SpGetContextToken,
     NULL, /* SpQueryContextAttributes */
     NULL, /* SpCompleteAuthToken */
     ntlm_SpDeleteUserModeContext,
diff --git a/dlls/secur32/lsa.c b/dlls/secur32/lsa.c
index 034ec65..d81cf6d 100644
--- a/dlls/secur32/lsa.c
+++ b/dlls/secur32/lsa.c
@@ -876,12 +876,39 @@ static SECURITY_STATUS WINAPI lsa_VerifySignature(CtxtHandle *context, SecBuffer
             message, message_seq_no, quality_of_protection);
 }
 
+static SECURITY_STATUS get_context_token(CtxtHandle *context, HANDLE *token)
+{
+    struct lsa_handle *lsa_ctx;
+
+    if (!context) return SEC_E_INVALID_HANDLE;
+    lsa_ctx = (struct lsa_handle *)context->dwLower;
+    if (!lsa_ctx || lsa_ctx->magic != LSA_MAGIC_CONTEXT) return SEC_E_INVALID_HANDLE;
+
+    if (!lsa_ctx->package->user_api || !lsa_ctx->package->user_api->GetContextToken)
+        return SEC_E_UNSUPPORTED_FUNCTION;
+
+    return lsa_ctx->package->user_api->GetContextToken(LSA_USER_HANDLE(lsa_ctx->handle), token);
+}
+
 static SECURITY_STATUS WINAPI lsa_QuerySecurityContextToken(CtxtHandle *context, HANDLE *token)
 {
-    HANDLE primary;
+    SECURITY_STATUS status;
+    HANDLE ctx_token, primary;
     BOOL r;
 
-    FIXME("%p %p): stub\n", context, token);
+    TRACE("%p %p\n", context, token);
+
+    status = get_context_token(context, &ctx_token);
+    if (status == SEC_E_OK)
+    {
+        if (!DuplicateHandle(GetCurrentProcess(), ctx_token, GetCurrentProcess(), token, 0, FALSE,
+                             DUPLICATE_SAME_ACCESS))
+            return SEC_E_INTERNAL_ERROR;
+        return SEC_E_OK;
+    }
+    if (status == SEC_E_INVALID_HANDLE) return status;
+
+    FIXME("%p %p: no context token, returning process token\n", context, token);
 
     if (!OpenProcessToken(GetCurrentProcess(), MAXIMUM_ALLOWED, &primary))
         return GetLastError();
@@ -890,6 +917,26 @@ static SECURITY_STATUS WINAPI lsa_QuerySecurityContextToken(CtxtHandle *context,
     return r ? SEC_E_OK : GetLastError();
 }
 
+static SECURITY_STATUS WINAPI lsa_ImpersonateSecurityContext(CtxtHandle *context)
+{
+    SECURITY_STATUS status;
+    HANDLE token;
+
+    TRACE("%p\n", context);
+
+    if ((status = lsa_QuerySecurityContextToken(context, &token))) return status;
+    status = SetThreadToken(NULL, token) ? SEC_E_OK : SEC_E_NO_IMPERSONATION;
+    CloseHandle(token);
+    return status;
+}
+
+static SECURITY_STATUS WINAPI lsa_RevertSecurityContext(CtxtHandle *context)
+{
+    TRACE("%p\n", context);
+
+    return RevertToSelf() ? SEC_E_OK : SEC_E_INTERNAL_ERROR;
+}
+
 static SECURITY_STATUS WINAPI lsa_EncryptMessage(CtxtHandle *context, ULONG quality_of_protection,
     SecBufferDesc *message, ULONG message_seq_no)
 {
@@ -940,8 +987,8 @@ static const SecurityFunctionTableW lsa_sspi_tableW =
     lsa_DeleteSecurityContext,
     NULL, /* ApplyControlToken */
     lsa_QueryContextAttributesW,
-    NULL, /* ImpersonateSecurityContext */
-    NULL, /* RevertSecurityContext */
+    lsa_ImpersonateSecurityContext,
+    lsa_RevertSecurityContext,
     lsa_MakeSignature,
     lsa_VerifySignature,
     NULL, /* FreeContextBuffer */
@@ -972,8 +1019,8 @@ static const SecurityFunctionTableA lsa_sspi_tableA =
     lsa_DeleteSecurityContext,
     NULL, /* ApplyControlToken */
     lsa_QueryContextAttributesA,
-    NULL, /* ImpersonateSecurityContext */
-    NULL, /* RevertSecurityContext */
+    lsa_ImpersonateSecurityContext,
+    lsa_RevertSecurityContext,
     lsa_MakeSignature,
     lsa_VerifySignature,
     NULL, /* FreeContextBuffer */
@@ -984,7 +1031,7 @@ static const SecurityFunctionTableA lsa_sspi_tableA =
     NULL, /* ImportSecurityContextA */
     NULL, /* AddCredentialsA */
     NULL, /* Reserved8 */
-    NULL, /* QuerySecurityContextToken */
+    lsa_QuerySecurityContextToken,
     lsa_EncryptMessage,
     lsa_DecryptMessage,
     NULL, /* SetContextAttributesA */
diff --git a/dlls/secur32/negotiate.c b/dlls/secur32/negotiate.c
