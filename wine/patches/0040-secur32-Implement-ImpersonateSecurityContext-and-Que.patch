@@ -195,6 +195,17 @@ static NTSTATUS NTAPI nego_SpDeleteUserModeContext( LSA_SEC_HANDLE handle )
     return STATUS_SUCCESS;
 }
 
+static NTSTATUS NTAPI nego_SpGetContextToken( LSA_SEC_HANDLE context, HANDLE *token )
+{
+    struct user_ctx *ctxt;
+
+    TRACE( "%Ix, %p\n", context, token );
+
+    if (!(ctxt = find_user_ctx( context ))) return SEC_E_INVALID_HANDLE;
+    if (!ctxt->funcs->GetContextToken) return SEC_E_UNSUPPORTED_FUNCTION;
+    return ctxt->funcs->GetContextToken( ctxt->handle, token );
+}
+
 static SECPKG_USER_FUNCTION_TABLE nego_user_table =
 {
     nego_SpInstanceInit,
@@ -203,7 +214,7 @@ static SECPKG_USER_FUNCTION_TABLE nego_user_table =
     nego_SpVerifySignature,
     nego_SpSealMessage,
     nego_SpUnsealMessage,
-    NULL, /* SpGetContextToken */
+    nego_SpGetContextToken,
     NULL, /* SpQueryContextAttributes */
     NULL, /* SpCompleteAuthToken */
     nego_SpDeleteUserModeContext,
diff --git a/dlls/secur32/tests/ntlm.c b/dlls/secur32/tests/ntlm.c
index bb5e468..5641710 100644
--- a/dlls/secur32/tests/ntlm.c
+++ b/dlls/secur32/tests/ntlm.c
@@ -1676,13 +1676,15 @@ static void test_server_context(void)
     SecBufferDesc client_out_desc = { SECBUFFER_VERSION, 1, &client_out };
     SecBufferDesc server_in_desc = { SECBUFFER_VERSION, 2, server_in };
     SecBufferDesc server_out_desc = { SECBUFFER_VERSION, 1, &server_out };
-    BYTE client_buf[4096], server_buf[4096];
+    BYTE client_buf[4096], server_buf[4096], token_user[256], ctx_user[256];
     SEC_CHANNEL_BINDINGS bindings = { 0 };
     CredHandle client_cred, server_cred;
     CtxtHandle client_ctx, server_ctx;
     SECURITY_STATUS status;
+    HANDLE token, thread_token;
     TimeStamp expiry;
-    ULONG attrs;
+    ULONG attrs, size;
+    BOOL ret;
 
     status = AcquireCredentialsHandleW( NULL, (WCHAR *)L"NTLM", SECPKG_CRED_OUTBOUND, NULL, NULL, NULL, NULL,
                                         &client_cred, &expiry );
@@ -1727,7 +1729,34 @@ static void test_server_context(void)
     status = AcceptSecurityContext( &server_cred, &server_ctx, &server_in_desc, 0, SECURITY_NATIVE_DREP,
                                     &server_ctx, &server_out_desc, &attrs, &expiry );
     ok( status == SEC_E_OK, "got %#lx\n", status );
+    if (status != SEC_E_OK) goto done;
 
+    OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token );
+    GetTokenInformation( token, TokenUser, token_user, sizeof(token_user), &size );
+    CloseHandle( token );
+
+    status = QuerySecurityContextToken( &server_ctx, &token );
+    ok( status == SEC_E_OK, "got %#lx\n", status );
+    if (!status)
+    {
+        ret = GetTokenInformation( token, TokenUser, ctx_user, sizeof(ctx_user), &size );
+        ok( ret, "got error %lu\n", GetLastError() );
+        ok( EqualSid( ((TOKEN_USER *)ctx_user)->User.Sid, ((TOKEN_USER *)token_user)->User.Sid ), "wrong user\n" );
+        CloseHandle( token );
+    }
+
+    status = ImpersonateSecurityContext( &server_ctx );
+    ok( status == SEC_E_OK, "got %#lx\n", status );
+    ret = OpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &thread_token );
+    ok( ret, "got error %lu\n", GetLastError() );
+    if (ret) CloseHandle( thread_token );
+    status = RevertSecurityContext( &server_ctx );
+    ok( status == SEC_E_OK, "got %#lx\n", status );
+    SetLastError( 0xdeadbeef );
+    ret = OpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &thread_token );
+    ok( !ret && GetLastError() == ERROR_NO_TOKEN, "got %d, error %lu\n", ret, GetLastError() );
+
+done:
     DeleteSecurityContext( &server_ctx );
     DeleteSecurityContext( &client_ctx );
     FreeCredentialsHandle( &server_cred );
