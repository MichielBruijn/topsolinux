 dlls/secur32/lsa.c        | 61 ++++++++++++++++++++++++++++++++++-----
 dlls/secur32/negotiate.c  | 13 ++++++++-
 dlls/secur32/tests/ntlm.c | 33 +++++++++++++++++++--
 4 files changed, 147 insertions(+), 13 deletions(-)

