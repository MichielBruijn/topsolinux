From 927f23334ec12a1cd9c775748ad518c80ee6d696 Mon Sep 17 00:00:00 2001
From: Michiel Bruijn <michiel@bruijn.nu>
Date: Sun, 11 Oct 2026 23:09:06 +0200
Subject: [PATCH 67/68] win32u: Don't make a screen-sized overlay window paint
 when it's shown.

TopSolid's drag feedback overlay copies the screen into itself when it paints while the
mouse is on another than the primary monitor, but a screen copy is black under XWayland
and the rest of its buffer is black too: dragging a docked panel from the laptop screen
turned the other monitor black. Without the paint it shows what is below it, like
Windows with the mouse on the primary monitor.
---
 dlls/win32u/window.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 87dd82bb0c9..7b7f4a52413 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2344,6 +2344,16 @@ static BOOL apply_window_pos( HWND hwnd, HWND insert_after, UINT swp_flags, stru
     old_surface = win->surface;
     if (old_surface != new_surface) swp_flags |= SWP_FRAMECHANGED;  /* force refreshing non-client area */
 
+    /* a screen-sized overlay shows what is below it, don't make it paint when it's shown */
+    if ((swp_flags & SWP_SHOWWINDOW) && !is_child && is_overlay_window( win->dwStyle, win->dwExStyle ))
+    {
+        MONITORINFO info = monitor_info_from_rect( new_rects->window, dpi );
+        RECT rect;
+
+        if (intersect_rect( &rect, &new_rects->window, &info.rcMonitor ) && EqualRect( &rect, &info.rcMonitor ))
+            swp_flags |= SWP_NOREDRAW;
+    }
+
     if (new_surface == &dummy_surface) swp_flags |= SWP_NOREDRAW;
     else if (old_surface == &dummy_surface)
     {
