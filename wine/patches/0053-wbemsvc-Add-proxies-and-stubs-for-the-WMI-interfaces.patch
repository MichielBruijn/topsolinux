From 2e07fd25eeab109bd4028ba309b9f653f5c2bd8d Mon Sep 17 00:00:00 2001
From: Michiel Bruijn <michiel@bruijn.nu>
Date: Mon, 5 Oct 2026 12:08:18 +0200
Subject: [PATCH 53/53] wbemsvc: Add proxies and stubs for the WMI interfaces.

wminet_utils wraps IWbemServices in an object of its own; .NET marshals that to the apartment that
uses it, which needs a proxy for IWbemServices (TopSolid's licence check without a wired network
adapter).
---
 dlls/wbemsvc/Makefile.in  |  7 +++++++
 dlls/wbemsvc/wbemsvc.idl  | 29 +++++++++++++++++++++++++++++
 dlls/wbemsvc/wbemsvc.spec |  5 +++++
 3 files changed, 41 insertions(+)
 create mode 100644 dlls/wbemsvc/Makefile.in
 create mode 100644 dlls/wbemsvc/wbemsvc.idl
 create mode 100644 dlls/wbemsvc/wbemsvc.spec

diff --git a/dlls/wbemsvc/Makefile.in b/dlls/wbemsvc/Makefile.in
new file mode 100644
index 0000000..2fe91d5
--- /dev/null
+++ b/dlls/wbemsvc/Makefile.in
@@ -0,0 +1,7 @@
+MODULE    = wbemsvc.dll
+IMPORTS   = oleaut32 rpcrt4
+
+SOURCES = \
+	wbemsvc.idl
+
+dlldata_EXTRADEFS = -DWINE_REGISTER_DLL
diff --git a/dlls/wbemsvc/wbemsvc.idl b/dlls/wbemsvc/wbemsvc.idl
new file mode 100644
index 0000000..0df68b4
--- /dev/null
+++ b/dlls/wbemsvc/wbemsvc.idl
@@ -0,0 +1,29 @@
+/*
+ * Proxies and stubs for the WMI interfaces
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#pragma makedep ident
+#pragma makedep proxy
+#pragma makedep register
+
+#include "wbemcli.idl"
+
+[
+    threading(both),
+    uuid(9556dc99-828c-11cf-a37e-00aa003240c7)  /* IWbemServices */
+]
+coclass PSFactoryBuffer { interface IPSFactoryBuffer; }
diff --git a/dlls/wbemsvc/wbemsvc.spec b/dlls/wbemsvc/wbemsvc.spec
new file mode 100644
index 0000000..7c7a65b
--- /dev/null
+++ b/dlls/wbemsvc/wbemsvc.spec
@@ -0,0 +1,5 @@
+@ stdcall -private DllCanUnloadNow()
+@ stdcall -private DllGetClassObject(ptr ptr ptr)
+@ stdcall -private DllRegisterServer()
+@ stdcall -private DllUnregisterServer()
+@ stdcall -private GetProxyDllInfo(ptr ptr)
-- 
2.53.0

