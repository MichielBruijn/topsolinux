#!/bin/bash
# topsolinux: start TopSolid with its local PDM under the bundled Wine
#
# usage: topsolinux-run [command]
#   (none)            start TopSolid
#   update            start TopSolid'Update
#   license FILE      install a Sentinel RMS license file (lservrc) and restart the license server
#   license-tool      start the TopSolid license tool
#   scale PERCENT     size of text and icons, e.g. 150 (kept until changed; 100 = normal)
#   scale auto        follow the desktop's scale again (the default)
#   spacemouse        SpaceMouse speeds and axes (works right away, also while TopSolid runs)
#   winecfg | shell | regedit
#   stop              stop all background services (SQL Server, PDM, license server)
#   debug [PROGRAM]   write the windows, focus and stacks of a hanging TopSolid (or PROGRAM.exe) to a file, stops nothing
#   report            make a zip with the logs for a problem report (asks to record TopSolid while it goes wrong)
#   record [update]   start TopSolid (or TopSolid'Update) and make that report when it closes
#   topsolinux-update update this TopSolid AppImage with the newest TopSo'Linux from GitHub, if there is one
#   update-check on|off  whether TopSolid looks for a newer TopSo'Linux when it starts (once a day; on)
#   mcp-install       install or update the TopSolid MCP server for AI assistants and turn on TopSolid's automation port
#   mcp               the MCP server on stdin/stdout, for an AI assistant (while TopSolid runs; see ~/.local/bin/topsolid-mcp)
#
# environment: TOPSOLID_GPU=auto|nvidia|default, TOPSOLID_GL=zink|native (Intel: zink, or iris without the draw-ID workaround), TOPSOLID_SCALE=PERCENT,
#              TOPSOLINUX_UPDATE_CHECK=0 (no update check at start),
#              TOPSOLINUX_HOME (default ~/.local/share/topsolinux)
#
# This script is used both inside a TopSolid AppImage (the prefix is then in $HERE/prefix and
# copied on the first start) and from a direct installation (the prefix is already in place).

set -u
HERE="$(dirname "$(readlink -f "$0")")"
DATA="${TOPSOLINUX_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/topsolinux}"
export WINEPREFIX="$DATA/prefix"
export WINE="$HERE/usr/bin/wine" WINESERVER="$HERE/usr/bin/wineserver"
export PATH="$HERE/usr/bin:$PATH"
export WINEDEBUG="${WINEDEBUG:-fixme-all}"
# no Wine menu or desktop entries: they would point at a prefix without this Wine
export WINEDLLOVERRIDES="winemenubuilder.exe=d${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
# Wine draws the arrow and other standard cursors from the X11 cursor theme, at the desktop's cursor size
[ -z "${XCURSOR_SIZE:-}" ] && [ -x "$HERE/usr/lib/topsolinux/desktop-dpi" ] &&
    export XCURSOR_SIZE=$("$HERE/usr/lib/topsolinux/desktop-dpi" --cursor)
# no drive letters for USB sticks and SD cards: Wine follows udisks on the system bus, and a card that
# drops out made TopSolid hang. They stay reachable through Z:
export DBUS_SYSTEM_BUS_ADDRESS="unix:path=/dev/null/no-system-bus"
PLACEHOLDER="__wineuser__"
MARKER="$WINEPREFIX/.topsolinux"
LOG="$DATA/topsolid.log"
TOOLS="$HERE/usr/lib/topsolinux"
TSL_VERSION="$(cat "$HERE/usr/share/doc/topsolinux/VERSION" 2>/dev/null)"
SPLASH="" SPLASH_FILE="$DATA/.splash"
ICON="$HERE/usr/share/icons/hicolor/256x256/apps/topsolinux.png"
[ -f "$TOOLS/appimage-name.sh" ] && . "$TOOLS/appimage-name.sh"
[ -f "$TOOLS/ntsync.sh" ] && . "$TOOLS/ntsync.sh"
LSERVRC='C:\Program Files (x86)\Common Files\Thales\Sentinel RMS License Manager\WinNT\lservrc'

msg() { echo "topsolinux: $*" >&2; }

# "TopSolid 7.20", from the AppImage's desktop entry
app_name() { local n; n="$(sed -n 's/^Name=//p' "$HERE"/*.desktop 2>/dev/null | head -1)"; echo "${n:-TopSolid}"; }

# TopSolid shows its own splash only after Wine, SQL Server and the local PDM have started
splash_start()  # TEXT
{
    [ -n "${DISPLAY:-}" ] && [ -f "$TOOLS/splash.py" ] && command -v python3 >/dev/null || return 0
    local sub
    sub="$(app_name)"
    [ -n "$TSL_VERSION" ] && sub="$sub · TopSo'Linux $TSL_VERSION"
    echo "# $1" > "$SPLASH_FILE"
    python3 "$TOOLS/splash.py" --status "$SPLASH_FILE" --icon "$ICON" \
        --title "TopSo'Linux" --subtitle "$sub" 2>>"$LOG" &
    SPLASH=$!
}
splash() { [ -n "$SPLASH" ] && echo "$*" >> "$SPLASH_FILE"; return 0; }
splash_stop() { [ -n "$SPLASH" ] && rm -f "$SPLASH_FILE"; SPLASH=""; }

# Started from a file manager or a terminal rather than the app menu: Install puts it in the app menu with
# Gear Lever (installed too when missing), Launch just starts it. Gear Lever asks the same when it opens an
# AppImage, but only when it is installed and the file isn't executable.
offer_install()
{
    local app
    [ -f "${APPIMAGE:-}" ] && [ -z "${DESKTOPINTEGRATION:-}" ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] &&
        command -v zenity >/dev/null && command -v integrate_appimage >/dev/null || return 1
    grep -qsF "$APPIMAGE" "$HOME/.local/share/applications/"*.desktop && return 1
    app="$(app_name)"
    zenity --question --width=480 --title="$app" --icon="$ICON" --ok-label=Install --cancel-label=Launch \
        --text="<b>Install</b> puts TopSolid in your app menu with Gear Lever (installed too when missing; installing Flatpak asks for your password) and starts it. Right-click its icon there for TopSolid'Update, the license tool, Wine settings, stopping the background services and TopSo'Linux updates.\n\n<b>Launch</b> only starts TopSolid.\n\n<small>TopSo'Linux $TSL_VERSION</small>" 2>/dev/null
}

install_appimage()
{
    local new
    gearlever_installed || splash "# Installing Gear Lever (once)..."
    if install_gearlever; then
        splash "# Adding TopSolid to the app menu..."
        if new="$(integrate_appimage "$APPIMAGE")"; then
            msg "added to the app menu: $new"
            APPIMAGE="$new"
            echo "$new" > "$DATA/appimage.path"
            return 0
        fi
    fi
    msg "adding TopSolid to the app menu failed"
    zenity --warning --width=420 --title="$(app_name)" --icon="$ICON" \
        --text="TopSolid could not be added to the app menu. It starts now; see $LOG." 2>/dev/null &
}

# Gear Lever names an AppImage it integrates after the app (topsolid_7.20.appimage): the version goes back in
fix_appimage_name()
{
    local new
    [ -f "${APPIMAGE:-}" ] && [ -n "$TSL_VERSION" ] && command -v versioned_name >/dev/null || return 0
    new="$(versioned_name "$APPIMAGE")"
    [ "$new" != "$APPIMAGE" ] && [ ! -e "$new" ] || return 0
    mv "$APPIMAGE" "$new" 2>/dev/null || return 0
    retarget_desktop_files "$APPIMAGE" "$new"
    echo "$new" > "$DATA/appimage.path"
    msg "renamed $APPIMAGE to ${new##*/}"
}

install_prefix()
{
    [ -f "$MARKER" ] && return
    [ -d "$HERE/prefix" ] || { msg "no TopSolid installation in $WINEPREFIX"; exit 1; }
    msg "first start, copying the TopSolid installation to $WINEPREFIX (this takes a few minutes)"
    splash "# First start: copying TopSolid to this computer (a few minutes)"
    mkdir -p "$WINEPREFIX" || exit 1
    # --remove-destination: a copy that was interrupted before left read-only files cp can't overwrite
    cp -a --remove-destination "$HERE/prefix/." "$WINEPREFIX/" || { msg "copy failed"; exit 1; }

    # the prefix was prepared for a placeholder user name
    local user="${USER:-$(id -un)}"
    if [ "$user" != "$PLACEHOLDER" ]; then
        mv "$WINEPREFIX/drive_c/users/$PLACEHOLDER" "$WINEPREFIX/drive_c/users/$user"
        sed -i "s/$PLACEHOLDER/$user/g" "$WINEPREFIX"/*.reg
        grep -rlI --null "$PLACEHOLDER" "$WINEPREFIX/drive_c/users/$user" "$WINEPREFIX/drive_c/ProgramData" 2>/dev/null |
            xargs -0 -r sed -i "s/$PLACEHOLDER/$user/g"
    fi
    # Command Prediction trains a neural network in the background all the time (1.4 cores, 10 GB); users can turn it on
    local conf
    for conf in "$WINEPREFIX/drive_c/users/$user/AppData/Roaming/TOPSOLID/TopSolid/"*/TopSolid/Kernel/SX; do
        [ -d "$conf" ] && python3 "$TOOLS/userconfig.py" --if-missing "$conf/Config.ConfigData.xml" \
            TopSolid/Kernel/WX/Application EnableCommandPrediction Bool False 2>/dev/null
    done
    # Z: is the home folder (see home_drive in prefix-settings.sh); the copy has the one of the machine that made it
    ln -sfn "$HOME" "$WINEPREFIX/dosdevices/z:"
    touch "$MARKER"
}

# remove the drive letters Wine made for removable drives before (see DBUS_SYSTEM_BUS_ADDRESS)
remove_auto_drives()
{
    local l
    for l in "$WINEPREFIX"/dosdevices/?:; do
        case "$(readlink "$l")" in /media/*|/run/media/*) rm -f "$l" ;; esac
    done
    for l in "$WINEPREFIX"/dosdevices/?::; do
        [ -L "${l%:}" ] || rm -f "$l"
    done
}

# TopSolid version installed in the prefix, e.g. 7.20
find_version()
{
    local d
    d="$(ls -d "$WINEPREFIX/drive_c/Program Files/TOPSOLID/TopSolid 7."* 2>/dev/null | sort -V | tail -1)"
    VERSION="${d##*TopSolid }"
    [ -n "$VERSION" ] || { msg "TopSolid is not installed in $WINEPREFIX"; exit 1; }
    TOPSOLID="C:\\Program Files\\TOPSOLID\\TopSolid $VERSION\\bin"
    PDM_SERVICE="TopSolid'Local Pdm Server $VERSION"
    USERCONFIG="$WINEPREFIX/drive_c/users/${USER:-$(id -un)}/AppData/Roaming/TOPSOLID/TopSolid/$VERSION/TopSolid/Kernel/SX/Config.ConfigData.xml"
}

setup_gpu()
{
    local mode="${TOPSOLID_GPU:-auto}"
    if [ "$mode" = auto ]; then
        # a hybrid laptop draws on its integrated GPU; on the NVIDIA one when the app menu's "Launch using
        # Discrete Graphics Card" (or prime-run) asked for it
        mode=default
        [ -d /proc/driver/nvidia ] && [ "${__NV_PRIME_RENDER_OFFLOAD:-}" = 1 ] && mode=nvidia
    fi
    echo "topsolinux: graphics $mode" >&2
    if [ "$mode" = nvidia ]; then
        export __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only
        [ -f /usr/share/glvnd/egl_vendor.d/10_nvidia.json ] &&
            export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
    fi
    # explicit sync lands the frame after Wine copied the 3D view: a delete showed up one frame late
    [ -d /proc/driver/nvidia ] && export __NV_X11_DISABLE_EXPLICIT_SYNC="${__NV_X11_DISABLE_EXPLICIT_SYNC:-1}"
    # Intel's OpenGL driver (iris) lets the GPU generate the draws of a multi-draw with 100 or more, and the
    # next draw then still reads the last of their gl_DrawIDs: an edge drawn with another part's transform and
    # color made a black bar in an assembly (https://gitlab.freedesktop.org/mesa/mesa/-/work_items/16588). The CPU loop iris uses below the threshold costs nothing measurable.
    # zink draws it right too, but has no polygon stipple (until Mesa 26.3): black instead of hatched cut faces.
    if [ "$mode" != nvidia ] && [ "$(primary_gpu_vendor)" = 0x8086 ]; then
        if [ "${TOPSOLID_GL:-}" = zink ] && compgen -G '/usr/share/vulkan/icd.d/intel_icd*.json' >/dev/null; then
            export MESA_LOADER_DRIVER_OVERRIDE="${MESA_LOADER_DRIVER_OVERRIDE:-zink}"
            echo "topsolinux: OpenGL through zink" >&2
        elif [ "${TOPSOLID_GL:-}" != native ]; then
            export generated_indirect_threshold="${generated_indirect_threshold:-1000000}"
        fi
    fi
}

# the vendor of the GPU that drives the screens (and draws for programs that don't ask for another one)
primary_gpu_vendor()
{
    local c
    for c in /sys/class/drm/card*; do
        case "${c##*/}" in *-*) continue ;; esac
        [ "$(cat "$c/device/boot_vga" 2>/dev/null)" = 1 ] && { cat "$c/device/vendor"; return; }
    done
}

pdm_state()
{
    "$WINE" sc query "$PDM_SERVICE" 2>/dev/null | tr -d '\r' | sed -n 's/.*STATE *: *[0-9]* *\([A-Z_]*\).*/\1/p'
}

# the port of the local PDM server, from its configuration (18080 by default)
pdm_listening()
{
    local conf port
    conf="$WINEPREFIX/drive_c/ProgramData/TOPSOLID/TopSolid'Local Pdm Server Service/$VERSION/TopSolid/Kernel/SX/Config.ConfigData.xml"
    port="$(sed -n 's/.*name="ServerPortNumber"[^>]*>\([0-9]*\)<.*/\1/p' "$conf" 2>/dev/null | head -1)"
    (exec 3<>"/dev/tcp/127.0.0.1/${port:-18080}") 2>/dev/null
}

# TopSolid gives up on the local PDM after a while, but its very first start on a new machine can take minutes
wait_for_pdm()
{
    local start=$SECONDS state retried=0 notify=""
    "$WINE" wineboot >/dev/null 2>&1
    [ "$(pdm_state)" = RUNNING ] && pdm_listening && return
    if [ -n "$SPLASH" ]; then
        splash "# Starting SQL Server and the local PDM..."
    elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v zenity >/dev/null; then
        zenity --progress --pulsate --no-cancel --auto-close --title=TopSolid \
            --text="Starting SQL Server and the local PDM..." < <(while [ -e "$WINEPREFIX/.pdm-wait" ]; do echo 1; sleep 1; done; echo 100) &
        notify=$!
        touch "$WINEPREFIX/.pdm-wait"
    fi
    msg "waiting for the local PDM to start"
    while [ $((SECONDS - start)) -lt 900 ]; do
        state="$(pdm_state)"
        [ "$state" = RUNNING ] && break
        if [ "$state" = STOPPED ] && [ $retried = 0 ] && [ $((SECONDS - start)) -gt 30 ]; then
            msg "local PDM stopped, starting it again"
            "$WINE" net start "$PDM_SERVICE" >/dev/null 2>&1 &
            retried=1
        fi
        sleep 2
    done
    # the service reports running long before the PDM server accepts connections; TopSolid then tries to start
    # it again and fails ("Unable to start service"). Wait until it listens on its port.
    while [ "$state" = RUNNING ] && [ $((SECONDS - start)) -lt 900 ] && ! pdm_listening; do sleep 2; done
    msg "local PDM: ${state:-unknown} after $((SECONDS - start))s"
    rm -f "$WINEPREFIX/.pdm-wait"
    [ -n "$notify" ] && wait "$notify" 2>/dev/null
}

# a crashing program leaves a minidump in its temp folder instead of only a backtrace; winedbg writes
# where to the log; read a dump with winedbg FILE (C:\windows\syswow64\winedbg.exe for 32-bit programs)
setup_crash_dumps()
{
    grep -q 'winedbg --minidump' "$WINEPREFIX/system.reg" 2>/dev/null && return
    local key
    for key in 'HKLM\Software\Microsoft\Windows NT\CurrentVersion\AeDebug' \
               'HKLM\Software\Wow6432Node\Microsoft\Windows NT\CurrentVersion\AeDebug'; do
        # stdout only: the first Wine program starts the services, and they keep its stderr (the log)
        "$WINE" reg add "$key" /v Debugger /d 'winedbg --minidump %ld %ld' /f >/dev/null
    done
}

# TopSolid's dialogs can hang in an endless WM_PAINT under Wine (see tools/unstick.c); a watchdog
# runs next to TopSolid and is stopped with the background services
start_unstick()
{
    local exe="$HERE/usr/lib/topsolinux/unstick.exe"
    [ -f "$exe" ] || return
    "$WINE" "$exe" > >(tee -a "$LOG") 2>&1 &
    UNSTICK=$!
}

# Windows applications scale text and icons with the DPI, 96 is 100%
set_dpi() { "$WINE" reg add 'HKCU\Control Panel\Desktop' /v LogPixels /t REG_DWORD /d "$1" /f >/dev/null 2>&1; }

set_scale()
{
    case "$1" in ""|*[!0-9]*) msg "scale must be a percentage, e.g. 150, or auto"; exit 1 ;; esac
    set_dpi $(( $1 * 96 / 100 ))
}

# a scale chosen with the scale command, else the desktop's, unless it was changed in Wine's settings
apply_scale()
{
    local cur last want
    if [ -n "${TOPSOLID_SCALE:-}" ]; then set_scale "$TOPSOLID_SCALE"; return; fi
    if [ -f "$DATA/scale" ]; then set_scale "$(cat "$DATA/scale")"; return; fi
    [ -x "$HERE/usr/lib/topsolinux/desktop-dpi" ] || return
    cur="$(awk '/^\[Control Panel\\\\Desktop\]/ { s = 1; next } /^\[/ { s = 0 }
        s && /^"LogPixels"=dword:/ { sub(/.*dword:/, ""); print }' "$WINEPREFIX/user.reg" 2>/dev/null)"
    [ -n "$cur" ] && cur=$((16#$cur))
    last="$(cat "$DATA/.auto-dpi" 2>/dev/null)"
    want="$("$HERE/usr/lib/topsolinux/desktop-dpi")"
    [ -n "$cur" ] && [ -n "$last" ] && [ "$cur" != "$last" ] && [ "$cur" != "$want" ] && return
    [ "$want" != "$cur" ] && set_dpi "$want"
    echo "$want" > "$DATA/.auto-dpi"
}

# a value in HKCU\Control Panel\International, as written in user.reg
reg_international()
{
    awk -v v="$1" '/^\[Control Panel\\\\International\]/ { s = 1; next } /^\[/ { s = 0 }
        s && index($0, "\"" v "\"=\"") == 1 { sub(/^[^=]*="/, ""); sub(/"$/, ""); print }' "$WINEPREFIX/user.reg" 2>/dev/null
}

# Wine takes the number format and the measurement system from the language (LC_MESSAGES); use the
# desktop's (LC_NUMERIC and LC_MEASUREMENT, "Formats" in the desktop settings) instead, unless they
# were changed with regedit. TopSolid uses inches by default when the measurement system isn't metric.
apply_formats()
{
    local dec thou list measure want cur last
    dec="$(locale decimal_point 2>/dev/null)"
    thou="$(locale thousands_sep 2>/dev/null)"
    [ -n "$dec" ] || return
    # e.g. the narrow no-break space of French: a plain space
    printf %s "$thou" | LC_ALL=C grep -q '[^ -~]' && thou=" "
    if [ "$dec" = "," ]; then list=";"; else list=","; fi
    # LC_MEASUREMENT: 1 metric, 2 US; Windows: 0 metric, 1 US
    if [ "$(locale measurement 2>/dev/null)" = 2 ]; then measure=1; else measure=0; fi
    want="$dec|$thou|$list|$measure"
    cur="$(reg_international sDecimal)|$(reg_international sThousand)|$(reg_international sList)|$(reg_international iMeasure)"
    last="$(cat "$DATA/.auto-formats" 2>/dev/null)"
    # changed by hand, and not reset by Wine for a new locale: keep it
    [ -n "$last" ] && [ "$cur" != "${last#*|}" ] && [ "$(reg_international LocaleName)" = "${last%%|*}" ] && return
    if [ "$cur" != "$want" ]; then
        set_international sDecimal "$dec"
        set_international sThousand "$thou"
        set_international sList "$list"
        set_international iMeasure "$measure"
    fi
    echo "$(reg_international LocaleName)|$want" > "$DATA/.auto-formats"
}

# stdout only: the first Wine program starts the services, and they keep its stderr (the log)
set_international() { "$WINE" reg add 'HKCU\Control Panel\International' /v "$1" /d "$2" /f >/dev/null; }

# Windows keeps the regional format (user locale) apart from the display language, Wine takes its user
# locale from the system UI languages: name LC_NUMERIC's locale there, e.g. nl-NL numbers with English
# texts. With an en-US user locale and a decimal comma, en-US itself got the comma, and TopSolid's text
# STL, written with en-US on purpose, had commas.
apply_format_locale()
{
    local key='HKCU\Control Panel\Desktop\MuiCached' want last
    want="${LC_ALL:-${LC_NUMERIC:-${LANG:-}}}"
    want="${want%%.*}"; want="${want%%@*}"
    case "$want" in C|POSIX|"") want="" ;; *) want="${want//_/-}" ;; esac
    last="$(cat "$DATA/.format-locale" 2>/dev/null)"
    [ "$want" = "$last" ] && return
    if [ -n "$want" ]; then
        "$WINE" reg add "$key" /v MachinePreferredUILanguages /t REG_MULTI_SZ /d "$want" /f >/dev/null
    else
        "$WINE" reg delete "$key" /v MachinePreferredUILanguages /f >/dev/null 2>&1
    fi
    echo "$want" > "$DATA/.format-locale"
}

# the managed and native stacks of a hanging program, for a bug report; attaches only to that program
# the windows, keyboard focus and stacks of a running PROGRAM.exe (TopSolid.exe by default)
program_state()  # [PROGRAM]
{
    local name="${1:-TopSolid}" pid clr="$HERE/usr/lib/topsolinux/clrstack"
    name="${name%.exe}.exe"
    pid="$("$WINE" winedbg --command "info process" 2>/dev/null |
        awk -v n="'$name'" 'tolower($NF) == tolower(n) { gsub(/[^0-9a-fA-F]/, "", $1); print $1; exit }')"
    [ -n "$pid" ] || { echo "$name is not running"; return 1; }
    echo "=== $name (pid $pid), $(date '+%F %T'), TopSo'Linux $TSL_VERSION"
    echo; echo "=== windows, keyboard focus and mouse capture"
    [ -f "$TOOLS/guiprobe.exe" ] && "$WINE" "$TOOLS/guiprobe.exe" "$pid"
    echo; echo "=== managed stacks"
    if [ -f "$clr/clrstack.exe" ]; then
        # .NET doesn't load programs from Z:, so it runs from the prefix
        rm -rf "$WINEPREFIX/drive_c/windows/temp/clrstack"
        cp -a "$clr" "$WINEPREFIX/drive_c/windows/temp/"
        "$WINE" 'C:\windows\temp\clrstack\clrstack.exe' "$pid"
    else
        echo "(not in this AppImage)"
    fi
    # no native stacks: when winedbg detaches, the thread it injected to attach crashes the program
}

debug_program()  # [PROGRAM]
{
    local out="$HOME/topsolid-debug-$(date +%Y%m%d-%H%M%S).txt"
    if ! program_state "${1:-}" > "$out" 2>&1; then
        msg "$(cat "$out")"; rm -f "$out"
        # winedbg started the prefix and its services; nothing to keep them running for
        topsolid_running || stop_services
        exit 1
    fi
    { echo; echo "=== end of the log"; tail -40 "$LOG"; } >> "$out"
    msg "done: $out"
}

gui() { [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v zenity >/dev/null; }

# zenity's info, error or question, and the message in the log; in a terminal a question counts as yes
tell()  # info|error|question TEXT
{
    msg "$(printf '%b' "$2" | sed 's/<[^>]*>//g' | tr -s '\n' ' ')"
    if gui; then
        zenity --"$1" --width=460 --title="$(app_name)" --icon="$ICON" --text="$2" 2>/dev/null ||
            { [ "$1" = question ] && msg "answered no"; return 1; }
    else
        [ "$1" != error ]
    fi
}

# Sentinel HL protection keys (USB vendor 0529): under Wine, Sentinel LDK doesn't open the key itself
# but asks the License Manager on localhost:1947. That is Thales' Run-time Environment for Linux
# (aksusbd, hasplmd); Thales offers it only behind a login, so it comes from a mirror, checked here.
SENTINEL_URL=https://download.gaisler.com/products/hasp/bin
SENTINEL_DEB="Sentinel_LDK_Ubuntu_DEB_Run-time_Installer cd24e3d4625559e572a427268286f23129c319dc32ada472abd58c4e7f38e55f"
SENTINEL_RPM="Sentinel_LDK_RedHat_and_SuSE_RPM_Run-time_Installer c00e323a24a06a431c9c62b93ade74887911060454a455bda4d39c69a49aafb9"
sentinel_runtime()
{
    local keys k name sum pattern install tmp file triggers=""
    keys="$(grep -lx 0529 /sys/bus/usb/devices/*/idVendor 2>/dev/null)"
    [ -n "$keys" ] && [ ! -x /usr/sbin/hasplmd ] && [ ! -f "$DATA/.sentinel-skip" ] || return 0
    if command -v dpkg >/dev/null; then read -r name sum <<< "$SENTINEL_DEB"; pattern='*_amd64.deb'; install='dpkg -i'
    elif command -v rpm >/dev/null; then read -r name sum <<< "$SENTINEL_RPM"; pattern='*.x86_64.rpm'; install='rpm -U'
    fi
    if [ -z "${name:-}" ] || ! command -v pkexec >/dev/null; then
        tell info "<b>Protection key found</b>\n\nTopSolid uses it through the Sentinel LDK Run-time Environment for Linux. Install it from Thales (aksusbd), then unplug the key and plug it in again."
        return 0
    fi
    if ! tell question "<b>Protection key found</b>\n\nTopSolid uses it through the Sentinel LDK Run-time Environment for Linux of Thales. Install it now? This is done once and asks for your password."; then
        touch "$DATA/.sentinel-skip"
        return 0
    fi
    tmp="$(mktemp -d)"
    python3 -I "$TOOLS/topsolinux-release.py" download "$SENTINEL_URL/$name.tar.gz" "$tmp/rte.tar.gz" 2>>"$LOG" |
        if gui; then zenity --progress --auto-close --width=460 --title="$(app_name)" --icon="$ICON" \
            --text="Downloading the Sentinel Run-time Environment..." 2>/dev/null; else cat >/dev/null; fi
    if [ "${PIPESTATUS[0]}" = 0 ] && echo "$sum  $tmp/rte.tar.gz" | sha256sum -c --status &&
        tar -xzf "$tmp/rte.tar.gz" -C "$tmp" --wildcards "$name/$pattern" 2>>"$LOG"; then
        file="$(ls "$tmp/$name"/$pattern | head -1)"
        # a key that was already plugged in is only seen after udev adds it again
        for k in $keys; do triggers="$triggers ${k%/idVendor}"; done
        pkexec sh -c "$install '$file' && udevadm trigger --action=add --settle$triggers" >> "$LOG" 2>&1 &&
            msg "Sentinel Run-time Environment installed"
    fi
    rm -rf "$tmp"
    [ -x /usr/sbin/hasplmd ] && return 0
    tell error "Installing the Sentinel Run-time Environment failed (see ${LOG/#$HOME/\~}). TopSolid starts without the protection key."
    return 0
}

# Wine's waits in the kernel instead of the wineserver (see ntsync.sh): offered once to an installation
# made before the installer loaded the driver
ntsync_offer()
{
    local state
    command -v ntsync_state >/dev/null || return 0
    state="$(ntsync_state)"
    if [ "$state" = off ] && [ ! -f "$DATA/.ntsync-skip" ] && command -v pkexec >/dev/null; then
        if ! tell question "<b>Smoother TopSolid</b>\n\nLinux's ntsync driver lets Wine do its waiting in the kernel, so TopSolid, SQL Server and the PDM wait less on each other. Load it now and at every start of the computer? This is done once and asks for your password."; then
            touch "$DATA/.ntsync-skip"
        elif ntsync_load >> "$LOG" 2>&1; then
            state=on
            # a wineserver that already runs keeps waiting without it
            pgrep -u "$(id -u)" -x wineserver >/dev/null && msg "ntsync loaded, used from the next start of the background services"
        else
            tell error "Loading the ntsync driver failed (see ${LOG/#$HOME/\~}). TopSolid starts without it."
        fi
    fi
    msg "ntsync: $state"
}

# the newest release on GitHub: sets LATEST, LATEST_URL and LATEST_SUMS; fails when it can't be found
find_latest()  # [TIMEOUT]
{
    local info
    info="$(timeout "${1:-60}" python3 -I "$TOOLS/topsolinux-release.py" latest 2>>"$LOG")" || return 1
    { read -r LATEST; read -r LATEST_URL; read -r LATEST_SUMS; } <<< "$info"
    [ -n "$LATEST" ]
}

newer() { [ "$(printf '%s\n' "$1" "$TSL_VERSION" | sort -V | tail -1)" != "$TSL_VERSION" ]; }

# Check for TopSo'Linux updates (app menu): ask, then update
topsolinux_update()
{
    [ -f "${APPIMAGE:-}" ] || { tell error "Only a TopSolid AppImage can update itself."; return 1; }
    find_latest || { tell error "Looking for TopSo'Linux updates on GitHub failed, see <tt>${LOG/#$HOME/\~}</tt>."; return 1; }
    if ! newer "$LATEST"; then
        tell info "TopSo'Linux $TSL_VERSION is the newest version."
        return 0
    fi
    tell question "<big><b>TopSo'Linux $LATEST is available</b></big>\n\nThis TopSolid has $TSL_VERSION. Download the new installer and update this TopSolid AppImage with it? Your installation and projects stay.\n\n<a href=\"https://github.com/MichielBruijn/topsolinux/releases/tag/v$LATEST\">What's new</a>" ||
        return 0
    install_latest
}

# The installer of LATEST from GitHub, checked against its SHA256SUMS, updates this TopSolid AppImage
install_latest()
{
    local release="$TOOLS/topsolinux-release.py" dir inst
    dir="$(xdg-user-dir DOWNLOAD 2>/dev/null)"
    [ -d "$dir" ] && [ "$dir" != "$HOME" ] || dir="$HOME/Downloads"
    mkdir -p "$dir"
    inst="$dir/${LATEST_URL##*/}"
    msg "downloading $LATEST_URL"
    python3 -I "$release" download "$LATEST_SUMS" "$inst.sha256" 2>>"$LOG" >/dev/null &&
        python3 -I "$release" download "$LATEST_URL" "$inst" 2>>"$LOG" |
        if gui; then zenity --progress --auto-close --width=460 --title="$(app_name)" --icon="$ICON" \
            --text="Downloading TopSo'Linux $LATEST..." 2>/dev/null; else cat >/dev/null; fi
    if [ "${PIPESTATUS[0]}" != 0 ] || [ ! -f "$inst" ]; then
        rm -f "$inst.part" "$inst.sha256"
        tell error "Downloading TopSo'Linux $LATEST failed or was cancelled."
        return 1
    fi
    if ! (cd "$dir" && grep -F " ${inst##*/}" "$inst.sha256" | sha256sum -c --status); then
        rm -f "$inst" "$inst.sha256"
        tell error "The downloaded installer doesn't match its checksum, nothing was changed."
        return 1
    fi
    rm -f "$inst.sha256"
    chmod +x "$inst"
    msg "updating $APPIMAGE with $inst"
    exec "$inst" update-appimage "$APPIMAGE"
}

# --- the TopSolid MCP server for AI assistants: a separate community project, downloaded from its releases --
MCP="$DATA/mcp"
MCP_SITE=https://github.com/Julien38300/topsolid-automation-mcp
MCP_LAUNCHER="$HOME/.local/bin/topsolid-mcp"

mcp_version() { cat "$MCP/.release" 2>/dev/null; }
mcp_newer() { [ "$(printf '%s\n' "$1" "$(mcp_version)" | sort -V | tail -1)" != "$(mcp_version)" ]; }

# the newest release: sets MCP_LATEST, MCP_URL and MCP_SUMS; fails when it can't be found
find_mcp_latest()  # [TIMEOUT]
{
    local info
    info="$(timeout "${1:-60}" python3 -I "$TOOLS/topsolinux-release.py" mcp-latest 2>>"$LOG")" || return 1
    { read -r MCP_LATEST; read -r MCP_URL; read -r MCP_SUMS; } <<< "$info"
    [ -n "$MCP_LATEST" ]
}

# MCP_URL, checked against its SHA256SUMS, replaces the server in $MCP; its settings.json stays
mcp_download()
{
    local release="$TOOLS/topsolinux-release.py" tmp zip
    tmp="$(mktemp -d)"
    zip="$tmp/${MCP_URL##*/}"
    msg "downloading $MCP_URL"
    python3 -I "$release" download "$MCP_SUMS" "$tmp/SHA256SUMS" 2>>"$LOG" >/dev/null &&
        python3 -I "$release" download "$MCP_URL" "$zip" 2>>"$LOG" |
        if gui; then zenity --progress --auto-close --width=460 --title="$(app_name)" --icon="$ICON" \
            --text="Downloading the TopSolid MCP server $MCP_LATEST..." 2>/dev/null; else cat >/dev/null; fi
    if [ "${PIPESTATUS[0]}" != 0 ] || [ ! -f "$zip" ]; then
        rm -rf "$tmp"
        tell error "Downloading the TopSolid MCP server $MCP_LATEST failed or was cancelled."
        return 1
    fi
    # made on Windows: CRLF
    if ! (cd "$tmp" && tr -d '\r' < SHA256SUMS | grep -F " ${zip##*/}" | sha256sum -c --status); then
        rm -rf "$tmp"
        tell error "The downloaded TopSolid MCP server doesn't match its checksum, nothing was changed."
        return 1
    fi
    rm -rf "$MCP.new"
    if ! python3 -I "$release" unzip "$zip" "$MCP.new" 2>>"$LOG" || [ ! -f "$MCP.new/TopSolidMcpServer.exe" ]; then
        rm -rf "$tmp" "$MCP.new"
        tell error "Unpacking the TopSolid MCP server failed, see <tt>${LOG/#$HOME/\~}</tt>."
        return 1
    fi
    rm -rf "$tmp"
    [ -f "$MCP/settings.json" ] && cp -p "$MCP/settings.json" "$MCP.new/"
    echo "$MCP_LATEST" > "$MCP.new/.release"
    rm -rf "$MCP.old"
    [ -d "$MCP" ] && mv "$MCP" "$MCP.old"
    mv "$MCP.new" "$MCP" && rm -rf "$MCP.old"
    msg "TopSolid MCP server $MCP_LATEST installed in $MCP"
}

# Options → General → Automation → Manage remote access: the MCP server reaches TopSolid on TCP port 8090.
# TopSolid writes its options when it closes, so this is set while it is closed.
remote_access_on() { grep -qs '<Value name="ManagesTcp" type="Bool"[^>]*>True<' "$USERCONFIG"; }
enable_remote_access()
{
    mkdir -p "${USERCONFIG%/*}"
    python3 "$TOOLS/userconfig.py" "$USERCONFIG" TopSolid/Kernel/SX/Automating ManagesTcp Bool True 2>>"$LOG" &&
        python3 "$TOOLS/userconfig.py" --if-missing "$USERCONFIG" TopSolid/Kernel/SX/Automating TcpPort Int 8090 2>>"$LOG"
}
# installed while TopSolid ran: turned on at the next start of TopSolid, before it reads its options
MCP_REMOTE_PENDING="$DATA/.mcp-remote-access"
pending_remote_access()
{
    [ -f "$MCP_REMOTE_PENDING" ] && ! topsolid_running || return 0
    { remote_access_on || enable_remote_access; } && rm -f "$MCP_REMOTE_PENDING" && msg "TopSolid's automation port turned on"
}

# a fixed command for AI assistants: the AppImage's name changes with every update, appimage.path follows it
mcp_launcher()
{
    mkdir -p "${MCP_LAUNCHER%/*}"
    cat > "$MCP_LAUNCHER" <<EOF
#!/bin/sh
# made by TopSo'Linux: the TopSolid MCP server for AI assistants (stdio), while TopSolid runs
app="\$(cat "$DATA/appimage.path" 2>/dev/null)"
[ -x "\$app" ] || app="${APPIMAGE:-$HERE/AppRun}"
exec "\$app" mcp "\$@"
EOF
    chmod +x "$MCP_LAUNCHER"
}

# App menu "MCP server for AI assistants": install or update it, turn on TopSolid's automation port and
# make the command for AI assistants
mcp_install()  # [offer]
{
    local have later=""
    have="$(mcp_version)"
    # offer: asked once, after the installation or an update, only when it isn't there, and no error without GitHub
    [ "${1:-}" = offer ] && { [ -n "$have" ] || [ -f "$DATA/.mcp-offered" ]; } && return 0
    if ! find_mcp_latest; then
        [ "${1:-}" = offer ] && { msg "not offering the TopSolid MCP server: GitHub can't be reached"; return 0; }
        tell error "Looking for the TopSolid MCP server on GitHub failed, see <tt>${LOG/#$HOME/\~}</tt>."; return 1
    fi
    [ "${1:-}" = offer ] && touch "$DATA/.mcp-offered"
    if [ -z "$have" ]; then
        tell question "<big><b>MCP server for AI assistants</b></big>\n\nThe TopSolid MCP server lets AI assistants such as Claude Code, Codex or GitHub Copilot in VS Code read and change what is open in TopSolid, and search TopSolid's help and API. It is a <a href=\"$MCP_SITE\">separate community project</a>, not part of TopSo'Linux or TopSolid.\n\nInstall version $MCP_LATEST? It is downloaded from GitHub (11 MB), and TopSolid's automation port gets turned on (<i>Options → General → Automation → Manage remote access</i>). TopSolid then listens on TCP port 8090 on all networks, as on Windows: on a network you don't trust, block that port with a firewall." ||
            return 0
    fi
    if [ -z "$have" ] || mcp_newer "$MCP_LATEST"; then
        mcp_download || return 1
    fi
    # TopSolid saves its options when it closes, and would turn the port off again
    if remote_access_on; then
        rm -f "$MCP_REMOTE_PENDING"
    elif topsolid_running; then
        touch "$MCP_REMOTE_PENDING"
        later="\n\n<b>Close TopSolid and start it again</b>: its automation port is turned on at the next start."
    else
        enable_remote_access ||
            { tell error "Turning on TopSolid's automation port failed, see <tt>${LOG/#$HOME/\~}</tt>."; return 1; }
    fi
    mcp_launcher
    tell info "<big><b>The TopSolid MCP server $(mcp_version) is installed</b></big>$later\n\nAdd it to your AI assistant as the command <tt>${MCP_LAUNCHER/#$HOME/\~}</tt>, for example:\n• Claude Code: <tt>claude mcp add --scope user topsolid -- ${MCP_LAUNCHER/#$HOME/\~}</tt>\n• Codex: <tt>codex mcp add topsolid -- ${MCP_LAUNCHER/#$HOME/\~}</tt>\n• VS Code: <i>MCP: Add Server…</i> → <i>Command (stdio)</i>, with this command\n\nIt works while TopSolid runs: start TopSolid before the assistant, or reconnect the assistant to it afterwards. Let the assistant ask before it runs scripts (<tt>topsolid_execute_script</tt>, <tt>topsolid_modify_script</tt>): they run on your computer. Newer versions are offered with TopSo'Linux's updates.\n\nQuestions about the MCP server: <a href=\"$MCP_SITE/issues\">its project</a>."
}

# The MCP server on stdin and stdout, for an AI assistant: nothing else may write to stdout
mcp_server()
{
    [ -f "$MCP/TopSolidMcpServer.exe" ] ||
        { msg "the TopSolid MCP server is not installed: right-click TopSolid in the app menu, MCP server for AI assistants"; exit 1; }
    # without TopSolid, Wine would start SQL Server and the PDM for it; closing TopSolid stops it again (stop_services)
    topsolid_running || { msg "TopSolid is not running: start it, then reconnect the AI assistant to the MCP server"; exit 1; }
    # its HTTP endpoint on port 8080 listens on all networks under Wine and without a key answers anyone
    TOPSOLID_MCP_API_KEY="$(head -c 32 /dev/urandom | base64 | tr -d '/+=')"
    export TOPSOLID_MCP_API_KEY
    cd "$WINEPREFIX/drive_c" && exec "$WINE" "$MCP/TopSolidMcpServer.exe" --no-tray "$@"
}

# a newer MCP server, asked like a newer TopSo'Linux (start_update_check); fails when GitHub can't be reached
mcp_update_check()
{
    local answer
    find_mcp_latest 15 || return 1
    mcp_newer "$MCP_LATEST" && [ "$(cat "$DATA/.mcp-update-skip" 2>/dev/null)" != "$MCP_LATEST" ] || return 0
    msg "TopSolid MCP server $MCP_LATEST is available"
    answer="$(zenity --question --width=480 --title="$(app_name)" --icon="$ICON" \
        --ok-label="Update now" --cancel-label="Later" --extra-button="Skip this version" \
        --text="<big><b>TopSolid MCP server $MCP_LATEST is available</b></big>\n\nThis computer has $(mcp_version). After the update, reconnect AI assistants that use it.\n\n<a href=\"$MCP_SITE/releases/tag/v$MCP_LATEST\">What's new</a>\n\n<small>Turn this check off with the command <tt>update-check off</tt>.</small>" 2>/dev/null)" &&
        mcp_download
    [ "$answer" = "Skip this version" ] && echo "$MCP_LATEST" > "$DATA/.mcp-update-skip" && msg "skipping MCP server $MCP_LATEST"
    return 0
}

# At most once a day, in the background while TopSolid starts: offer a newer TopSo'Linux. Off with
# TOPSOLINUX_UPDATE_CHECK=0 or the command update-check off; no network means no question
UPDATE_CHECK=""
start_update_check()
{
    local stamp="$DATA/.update-check"
    [ "${TOPSOLINUX_UPDATE_CHECK:-1}" != 0 ] && [ "$(cat "$DATA/update-check" 2>/dev/null)" != off ] && gui || return 0
    { [ -f "${APPIMAGE:-}" ] && [ -n "$TSL_VERSION" ]; } || [ -n "$(mcp_version)" ] || return 0
    [ -n "$(find "$stamp" -mmin -1440 2>/dev/null)" ] && return 0
    (
        # after TopSolid's own splash
        sleep 30
        # first: updating TopSo'Linux replaces this script
        [ -n "$(mcp_version)" ] && mcp_update_check && touch "$stamp"
        [ -f "${APPIMAGE:-}" ] && [ -n "$TSL_VERSION" ] || exit 0
        find_latest 15 || exit 0
        touch "$stamp"
        newer "$LATEST" && [ "$(cat "$DATA/.update-skip" 2>/dev/null)" != "$LATEST" ] || exit 0
        msg "TopSo'Linux $LATEST is available"
        answer="$(zenity --question --width=480 --title="$(app_name)" --icon="$ICON" \
            --ok-label="Update now" --cancel-label="Later" --extra-button="Skip this version" \
            --text="<big><b>TopSo'Linux $LATEST is available</b></big>\n\nThis TopSolid has $TSL_VERSION. <b>Update now</b> downloads the new installer and updates the TopSolid AppImage with it; a running TopSolid keeps this version until you close it. Your installation and projects stay.\n\n<a href=\"https://github.com/MichielBruijn/topsolinux/releases/tag/v$LATEST\">What's new</a>\n\n<small>Turn this check off with the command <tt>update-check off</tt>.</small>" 2>/dev/null)" &&
            install_latest
        [ "$answer" = "Skip this version" ] && echo "$LATEST" > "$DATA/.update-skip" && msg "skipping $LATEST"
    ) &
    UPDATE_CHECK=$!
}

stop_services()
{
    local svc i
    # held until this script exits, a start waits for it (see below)
    exec 9>"$DATA/.stop.lock"
    flock 9
    # a SQL Server that is still starting would be killed halfway (net stop can't stop it yet)
    if pgrep -u "$(id -u)" -f 'sqlservr\.exe' >/dev/null; then
        for i in $(seq 30); do
            "$WINE" sc query 'MSSQL$SQLTOPSOLID' 2>/dev/null 9>&- | grep -q START_PENDING || break
            sleep 2
        done
    fi
    for svc in "$PDM_SERVICE" 'MSSQL$SQLTOPSOLID' "Sentinel RMS License Manager"; do
        "$WINE" net stop "$svc" >/dev/null 2>&1 9>&-
    done
    "$WINESERVER" -k 9>&-
}

topsolid_running()
{
    pgrep -u "$(id -u)" -f '\\TopSolid[^\\]*\\bin\\TopSolid(\.Update)?\.exe' >/dev/null
}

run()
{
    # an AppImage is unmounted when this script exits, so keep it alive until all Wine processes are gone
    # stdout too: Wine's crash handler (winedbg --auto) writes its backtrace there
    "$WINE" "$@" > >(tee -a "$LOG")
    local ret=$?
    msg "${1##*\\} exited with code $ret"
    # TopSolid restarts itself after the first PDM login and after updates: wait for the new instance too
    while topsolid_running; do sleep 2; done
    # stop the watchdog first, it would restart the license server
    [ -n "${UNSTICK:-}" ] && { kill "$UNSTICK"; wait "$UNSTICK"; } 2>/dev/null
    stop_services
    return $ret
}

# --- problem reports: a zip with the logs and what the computer has, to send to whoever helps -------
REPORT_DESC="$DATA/report-description.txt"

# the Linux process of TopSolid or TopSolid'Update
topsolid_pid() { pgrep -u "$(id -u)" -f '^C:\\.*\\bin\\TopSolid(\.Update)?\.exe$' | head -1; }

# what TopSolid's busiest threads and the NVIDIA GPU do, every 2 seconds, until killed
record_load()  # FILE
{
    local pid
    while sleep 1; do
        pid="$(topsolid_pid)"
        [ -n "$pid" ] || continue
        {
            echo "=== $(date +%T)"
            # the second round of top measures the last second; its first lines are the totals
            top -H -b -n2 -d1 -w 160 -p "$pid" | awk '/^top -/ { n++ } n == 2' | sed -n '1p;7,17p'
            # memory in MB of the processes that can grow
            ps -u "$(id -u)" -o rss=,comm= | awk '$2 ~ /^(TopSolid|sqlservr|wineserver)/ { m[$2] += int($1 / 1024) }
                END { printf "memory MB:"; for (n in m) printf " %s %d", n, m[n]; print "" }'
            [ -d /proc/driver/nvidia ] && nvidia-smi --format=csv,noheader \
                --query-gpu=pstate,clocks.gr,power.draw,utilization.gpu 2>/dev/null | sed 's/^/NVIDIA: /'
        } >> "$1"
    done
}

GPU_VARS='^(__NV_PRIME_RENDER_OFFLOAD|__GLX_VENDOR_LIBRARY_NAME|__VK_LAYER_NV_optimus|__EGL_VENDOR_LIBRARY_FILENAMES|__NV_X11_[A-Z_]*|MESA_[A-Z_]*|INTEL_DEBUG|generated_indirect_threshold|DRI_PRIME|VK_LOADER_DRIVERS_SELECT|WINEDEBUG|TOPSOLID_[A-Z_]*)='

# the GPU variables TopSolid runs with; this script's own when it doesn't run
gpu_env()
{
    local pid
    pid="$(topsolid_pid)"
    if [ -n "$pid" ]; then tr '\0' '\n' < "/proc/$pid/environ"; else env; fi 2>/dev/null | grep -E "$GPU_VARS"
}

# which OpenGL driver Wine gives TopSolid: with the GPU variables of the running TopSolid
gl_info()
{
    local v unset=() set=()
    [ -f "$TOOLS/glinfo.exe" ] || return 0
    for v in $(env | grep -oE "$GPU_VARS" | tr -d =); do unset+=(-u "$v"); done
    mapfile -t set < <(gpu_env)
    env "${unset[@]}" "${set[@]}" "$WINE" "$TOOLS/glinfo.exe" 2>/dev/null | tr -d '\r'
}

system_info()  # [gl]: also which OpenGL driver Wine uses (starts the prefix)
{
    local c
    echo "TopSo'Linux $TSL_VERSION, $(date '+%F %T')"
    echo "AppImage: ${APPIMAGE:-none}"
    echo "TopSolid: ${VERSION:-?} ($(ls "$WINEPREFIX/drive_c/Program Files/TOPSOLID" 2>/dev/null | tr '\n' ',' | sed 's/,$//'))"
    echo "Wine: $("$WINE" --version 2>/dev/null), settings level $(cat "$WINEPREFIX/.topsolinux-settings" 2>/dev/null)"
    echo "install steps done: $(tr '\n' ' ' < "$DATA/install.state" 2>/dev/null)"
    echo; echo "=== system"
    . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-?}, kernel $(uname -r)"
    echo "desktop: ${XDG_CURRENT_DESKTOP:-?}, session ${XDG_SESSION_TYPE:-?}, DISPLAY=${DISPLAY:-} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"
    echo "CPU: $(sed -n 's/^model name\s*: //p' /proc/cpuinfo | head -1), $(nproc) threads"
    command -v ntsync_state >/dev/null && echo "ntsync: $(ntsync_state)"
    free -h | sed -n '1,2p'
    df -h "$DATA" "$HOME" 2>/dev/null | uniq
    echo; echo "=== graphics"
    for c in /sys/class/drm/card*; do
        case "${c##*/}" in *-*) continue ;; esac
        echo "${c##*/}: vendor $(cat "$c/device/vendor" 2>/dev/null) device $(cat "$c/device/device" 2>/dev/null)" \
            "driver $(basename "$(readlink "$c/device/driver")") boot_vga=$(cat "$c/device/boot_vga" 2>/dev/null)"
    done
    command -v lspci >/dev/null && lspci -nn | grep -E 'VGA|3D|Display'
    [ -f /proc/driver/nvidia/version ] && head -1 /proc/driver/nvidia/version
    echo "TopSolid's GPU variables: $(gpu_env | tr '\n' ' ')"
    [ "${1:-}" = gl ] && { echo "OpenGL under Wine:"; gl_info | sed 's/^/  /'; }
    echo; echo "=== screens"
    command -v xrandr >/dev/null && xrandr --listmonitors 2>/dev/null
    [ -x "$TOOLS/desktop-dpi" ] && echo "desktop dpi: $("$TOOLS/desktop-dpi" 2>/dev/null)"
    echo "scale: $(cat "$DATA/scale" 2>/dev/null || echo auto), LogPixels: $(grep -hi '"LogPixels"' "$WINEPREFIX/user.reg" "$WINEPREFIX/system.reg" 2>/dev/null | tr '\n' ' ')"
    echo; echo "=== services"
    for c in spacenavd aksusbd hasplmd ufw winbind; do
        # this script hides the system bus from Wine
        printf '%s: %s\n' "$c" "$(env -u DBUS_SYSTEM_BUS_ADDRESS systemctl is-active "$c" 2>/dev/null)"
    done
    echo "ntlm_auth: $(ntlm_auth --version 2>/dev/null || echo 'from the AppImage')"
}

# the zip goes to the Downloads folder; prints where it is
make_report()  # [STATE FILE] [gl]
{
    local name dir out f u
    name="topsolid-report-$(date +%Y%m%d-%H%M%S)"
    dir="$(mktemp -d)/$name"
    mkdir -p "$dir"
    [ -s "$REPORT_DESC" ] && cp "$REPORT_DESC" "$dir/description.txt"
    system_info "${2:-}" > "$dir/system.txt" 2>&1
    [ -s "$DATA/record.txt" ] && cp "$DATA/record.txt" "$dir/load.txt"
    [ -n "${1:-}" ] && [ -s "$1" ] && cp "$1" "$dir/stacks.txt"
    # the log of every start ever: its end is enough
    tail -c 8000000 "$LOG" > "$dir/topsolinux.log"
    tail -c 1000000 "$DATA/install.log" > "$dir/install.log" 2>/dev/null
    for u in "$WINEPREFIX/drive_c/users/"*/AppData/Roaming/TOPSOLID; do
        for f in "$u/TopSolid/"*/TopSolid.log "$u/TopSolid'Update/"*/TopSolid.Update.log; do
            [ -f "$f" ] && tail -c 2000000 "$f" > "$dir/${f##*/}"
        done
    done
    for f in "$WINEPREFIX/drive_c/ProgramData/TOPSOLID/TopSolid'Local Pdm Server Service/"*/Maintenance.log; do
        [ -f "$f" ] && tail -c 1000000 "$f" > "$dir/pdm-Maintenance.log"
    done
    for f in "$WINEPREFIX/drive_c/Program Files/Microsoft SQL Server/"*/MSSQL/Log/ERRORLOG; do
        [ -f "$f" ] && tail -c 1000000 "$f" > "$dir/sql-ERRORLOG.txt"
    done
    # crash dumps of the last week: the newest one, when it isn't huge
    find "$WINEPREFIX/drive_c/users" "$WINEPREFIX/drive_c/windows/temp" \( -name '*.mdmp' -o -name '*.dmp' \) -mtime -7 \
        -printf '%T@ %s %p\n' \
        2>/dev/null | sort -rn > "$dir/crash-dumps.txt"
    f="$(head -1 "$dir/crash-dumps.txt" | awk '$2 < 50000000 { sub(/^[^ ]+ [^ ]+ /, ""); print }')"
    [ -n "$f" ] && cp "$f" "$dir/"
    out="$(xdg-user-dir DOWNLOAD 2>/dev/null)"
    { [ -n "$out" ] && [ "$out" != "$HOME" ] && mkdir -p "$out"; } || out="$HOME"
    out="$out/$name.zip"
    (cd "${dir%/*}" && python3 -m zipfile -c "$out" "$name") >&2 || return 1
    rm -rf "${dir%/*}"
    rm -f "$DATA/record.txt" "$REPORT_DESC"
    echo "$out"
}

# where the report is, and the file manager showing it
report_done()  # ZIP
{
    [ -f "$1" ] || { tell error "Making the report failed. The log is $LOG."; return 1; }
    msg "problem report: $1"
    gui || return 0
    dbus-send --session --dest=org.freedesktop.FileManager1 --type=method_call /org/freedesktop/FileManager1 \
        org.freedesktop.FileManager1.ShowItems \
        array:string:"$(python3 -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).as_uri())' "$1")" string:"" \
        2>/dev/null || xdg-open "${1%/*}" >/dev/null 2>&1 &
    tell info "The report is saved as\n<b>$1</b>\n\nSend it to whoever helps you with TopSo'Linux. It has the logs and what this computer has, but no drawings, projects or license (their names can show up in the logs)."
}

# "Report a problem" in the app menu
report_problem()
{
    local choice state=""
    if gui; then
        python3 "$TOOLS/report-text.py" "$(app_name)" "$ICON" > "$REPORT_DESC" 2>>"$LOG"
        case $? in
            0) ;;
            2) zenity --forms --title="$(app_name)" --window-icon="$ICON" --width=560 --text="Report a problem" \
                   --add-multiline-entry="What goes wrong, and what did you do just before?" > "$REPORT_DESC" 2>/dev/null ||
                   { rm -f "$REPORT_DESC"; return 0; } ;;
            *) rm -f "$REPORT_DESC"; return 0 ;;
        esac
    fi
    if topsolid_running; then
        if tell question "TopSolid is running. When it is slow or stuck right now, the report can show what it does.\n\nRecord TopSolid for 20 seconds? Do the slow thing during that time."; then
            rm -f "$DATA/record.txt"
            record_load "$DATA/record.txt" & local rec=$!
            state="$(mktemp)"
            # the stacks halfway, while the slow thing happens
            record_stacks() { sleep 8; program_state TopSolid > "$state" 2>&1 || program_state TopSolid.Update > "$state" 2>&1; sleep 6; }
            if gui; then
                record_stacks | zenity --progress --pulsate --auto-close --no-cancel --title="$(app_name)" \
                    --text="Recording TopSolid for 20 seconds..." 2>/dev/null
            else
                record_stacks
            fi
            kill "$rec" 2>/dev/null
        fi
        report_done "$(make_report "${state:-}" gl)"
        [ -n "${state:-}" ] && rm -f "$state"
        return
    fi
    if gui; then
        choice="$(zenity --list --radiolist --title="$(app_name)" --window-icon="$ICON" --width=560 --height=280 \
            --text="TopSolid isn't running. Show what goes wrong while TopSo'Linux records it?" \
            --column="" --column=what --column="" --hide-column=3 --print-column=3 \
            TRUE "Start TopSolid and record (the report is made when you close it)" topsolid \
            FALSE "Start TopSolid'Update and record (the report is made when you close it)" update \
            FALSE "Only collect the logs" logs 2>/dev/null)" || { rm -f "$REPORT_DESC"; return 0; }
        case "$choice" in
            topsolid) exec "$0" record ;;
            update)   exec "$0" record update ;;
        esac
    fi
    report_done "$(make_report "" gl)"
    # glinfo started the prefix and its services
    stop_services
}

# with "record" in front, TopSolid or TopSolid'Update starts as usual, and closing it makes the report
start_recording()
{
    [ -n "$RECORD" ] || return 0
    { echo "OpenGL under Wine:"; gl_info | sed 's/^/  /'; } > "$DATA/record.txt"
    record_load "$DATA/record.txt" &
    RECORDER=$!
}

finish_recording()
{
    [ -n "$RECORD" ] || return 0
    kill "$RECORDER" 2>/dev/null
    report_done "$(make_report)"
}

mkdir -p "$DATA"
# the log of every start: keep the end of a big one (in place, a running TopSolid keeps writing to it)
if [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 50000000 ]; then
    tail -c 10000000 "$LOG" > "$LOG.tmp" && cat "$LOG.tmp" > "$LOG"; rm -f "$LOG.tmp"
fi
RECORD="" RECORDER=""
if [ "${1:-}" = record ]; then
    RECORD=1; shift
    export WINEDEBUG="+timestamp,$WINEDEBUG"
fi
exec 2> >(tee -a "$LOG" >&2)
# stopping the services ends with wineserver -k: wait for a stop in progress, or it kills what starts now
[ "${1:-}" = stop ] || flock -w 120 "$DATA/.stop.lock" true 2>/dev/null
echo "=== $(date '+%F %T') $0 ${*:-}" >&2
[ "${1:-}" = mcp ] && { shift; mcp_server "$@"; }

INSTALL=0
# a broken Gear Lever settings file stops Gear Lever from starting
command -v gearlever_conf >/dev/null && gearlever_conf
[ -z "${1:-}" ] && offer_install && INSTALL=1
case "${1:-}" in ""|update|license-tool) sentinel_runtime; ntsync_offer; splash_start "Starting Wine..."; trap splash_stop EXIT ;; esac
[ $INSTALL = 1 ] && { install_appimage; splash "# Starting Wine..."; }
fix_appimage_name
command -v add_update_actions >/dev/null && [ -f "${APPIMAGE:-}" ] && add_update_actions "$APPIMAGE"
case "${1:-}" in
    topsolinux-update) topsolinux_update; exit ;;
    update-check)
        case "${2:-}" in
            off) echo off > "$DATA/update-check"; msg "no more checks for TopSo'Linux updates at start" ;;
            on)  rm -f "$DATA/update-check" "$DATA/.update-check" "$DATA/.update-skip"
                 msg "TopSolid checks for TopSo'Linux updates at start again (once a day)" ;;
            *)   msg "usage: $0 update-check on|off"; exit 1 ;;
        esac
        exit ;;
esac

# Wine's NTLM uses Samba's ntlm_auth (the PDM logs in to SQL Server with it); prefer the system's
ntlm_auth --version >/dev/null 2>&1 || export PATH="$HERE/usr/lib/ntlm_auth/bin:$PATH"
# Wine starts programs in the current folder: from the desktop that is the home folder (Z:\), where
# TopSolid and Sentinel RMS then made TOPSOLID and Thales folders
[ "${1:-}" = license ] && [ -f "${2:-}" ] && set -- "$1" "$(readlink -f "$2")"
mkdir -p "$DATA" && cd "$DATA"
install_prefix
cd "$WINEPREFIX/drive_c" 2>/dev/null
remove_auto_drives
find_version
[ "${1:-}" = mcp-install ] && { mcp_install "${2:-}"; exit; }
# settings that newer versions of the installer make, for a prefix made by an older one
if [ -f "$TOOLS/prefix-settings.sh" ]; then
    . "$TOOLS/prefix-settings.sh"
    update_settings || msg "updating the Wine settings to level $SETTINGS_LEVEL failed"
fi
setup_gpu
setup_crash_dumps

case "${1:-}" in
    "")           apply_scale; apply_format_locale; apply_formats; wait_for_pdm; start_unstick
                  pending_remote_access
                  splash "# Starting TopSolid..."; splash "watch topsolid.exe"; start_update_check; start_recording
                  run "$TOPSOLID\\TopSolid.exe"; ret=$?; finish_recording
                  # a question about an update that is still open, or the update itself
                  [ -n "$UPDATE_CHECK" ] && wait "$UPDATE_CHECK"
                  exit $ret ;;
    update)       apply_scale; apply_format_locale; apply_formats; splash "# Starting TopSolid'Update..."; splash "watch topsolid.update.exe"
                  start_recording
                  run "C:\\Program Files\\TOPSOLID\\TopSolid Update\\bin\\TopSolid.Update.exe"; finish_recording ;;
    license-tool) apply_scale; apply_format_locale; apply_formats; splash "# Starting the license tool..."; splash "watch topsolid.license.exe"
                  run "$TOPSOLID\\TopSolid.License.exe" ;;
    license)
        [ -f "${2:-}" ] || { msg "usage: $0 license FILE"; exit 1; }
        cp "$2" "$("$WINE" winepath -u "$LSERVRC" 2>/dev/null)" && msg "license installed"
        stop_services ;;
    scale)        if [ "${2:-}" = auto ]; then rm -f "$DATA/scale" "$DATA/.auto-dpi"; apply_scale; msg "scale follows the desktop again"
                  else set_scale "${2:-}"; echo "$2" > "$DATA/scale"; msg "scale set to $2%, used from the next start of TopSolid"; fi
                  topsolid_running || "$WINESERVER" -w ;;
    # without GTK 3 the settings are in regedit, HKEY_CURRENT_USER\Software\Wine\TDxNavLib
    spacemouse)   python3 "$TOOLS/spacemouse.py" 2>>"$LOG"
                  [ $? = 2 ] && { apply_scale; apply_format_locale; apply_formats; run regedit; } ;;
    winecfg|regedit) apply_scale; apply_format_locale; apply_formats; run "$1" ;;
    shell)        msg "WINEPREFIX=$WINEPREFIX, wine is on PATH; exit the shell to stop the services"
                  bash; stop_services ;;
    stop)         stop_services ;;
    debug)        debug_program "${2:-}" ;;
    report)       report_problem ;;
    *)            msg "unknown command $1"; exit 1 ;;
esac
