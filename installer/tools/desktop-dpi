#!/bin/bash
# print the DPI at which X11 applications (like Wine) should draw to match the desktop's scale; 96 = 100%

# GNOME with Xwayland native scaling shows X11 windows unscaled: use the scale of the primary monitor
if [ -n "${WAYLAND_DISPLAY:-}" ] &&
    gsettings get org.gnome.mutter experimental-features 2>/dev/null | grep -q xwayland-native-scaling; then
    scale="$(gdbus call --session --dest org.gnome.Mutter.DisplayConfig --object-path /org/gnome/Mutter/DisplayConfig \
        --method org.gnome.Mutter.DisplayConfig.GetCurrentState 2>/dev/null |
        grep -o '([0-9-]*, [0-9-]*, [0-9.]*, uint32 [0-9]*, true' | head -1 | cut -d, -f3 | tr -d ' ')"
    text="$(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null)"
    if [ -n "$scale" ]; then
        awk -v s="$scale" -v t="${text:-1}" 'BEGIN { printf "%d\n", 96 * s * t + 0.5 }'
        exit
    fi
fi
# X11 sessions and KDE Plasma pass the scale to X11 applications as Xft.dpi
dpi="$(xrdb -query 2>/dev/null | sed -n 's/^Xft\.dpi:[[:space:]]*\([0-9]*\).*/\1/p' | head -1)"
echo "${dpi:-96}"
