#!/bin/bash
# TopSo'Linux installer: installs TopSolid under a patched Wine, from the user's installation media or from
# TopSolid's own download server, and makes a TopSolid AppImage of it
#
# usage: TopSoLinux-Installer.AppImage                      graphical installer
#        TopSoLinux-Installer.AppImage install --media DIR | --download DIR [--replace]
#                                          [--gearlever | --appimage-dir DIR] [--spacemouse | --no-spacemouse]
#        TopSoLinux-Installer.AppImage update-appimage [FILE]
#                                          give a TopSolid AppImage this version's Wine and starter
#
# environment: TOPSOLINUX_HOME (default ~/.local/share/topsolinux)
#
# Nothing of TopSolid, SQL Server or .NET is part of this installer: they come from the installation media.
# Only the Visual C++ runtime and .NET 4.0 (Microsoft) and the core fonts (SourceForge) are downloaded, by winetricks.

set -u
HERE="$(dirname "$(readlink -f "$0")")"
SHARE="$HERE/usr/share/topsolinux"
TOOLS="$HERE/usr/lib/topsolinux"
NAME="TopSo'Linux"
TSL_VERSION="$(cat "$SHARE/VERSION" 2>/dev/null || echo dev)"
TITLE="$NAME $TSL_VERSION"
ICON="$HERE/topsolinux.svg"
DATA="${TOPSOLINUX_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/topsolinux}"
LOG="$DATA/install.log"
STATE="$DATA/install.state"
export WINEPREFIX="$DATA/prefix"
export WINE="$HERE/usr/bin/wine" WINESERVER="$HERE/usr/bin/wineserver"
export PATH="$HERE/usr/bin:$TOOLS/bin:$PATH"
export LD_LIBRARY_PATH="$TOOLS/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export WINEDEBUG=-all WINEDLLOVERRIDES="winemenubuilder.exe=d"
SQLDIR="$WINEPREFIX/drive_c/Program Files/Microsoft SQL Server/MSSQL15.SQLTOPSOLID/MSSQL"
SQLPARAMS='HKLM\SOFTWARE\Microsoft\Microsoft SQL Server\MSSQL15.SQLTOPSOLID\MSSQLServer\Parameters'
OSQL='C:\Program Files\Microsoft SQL Server\150\Tools\Binn\OSQL.EXE'
RMS_PERSISTENCE="$WINEPREFIX/drive_c/ProgramData/SafeNet Sentinel/Sentinel RMS Development Kit/System"
GEARLEVER=it.mijorus.gearlever
NEED_GB=45

UPDATE_APPIMAGE=0 UPDATE_FROM=""
MEDIA="" DOWNLOAD=0 REPLACE=0 USE_GEARLEVER=1 APPIMAGE_DIR="" SPACEMOUSE=auto GUI=0 PROGRESS=""
APPIMAGE_OUT="" INTEGRATED="" UPDATED="" NOTES="" LAST_SAY="" PART="" PLAN="" LAST_TOTAL="" LAST_HEADING="" PROGRESS_SINCE=""

# --- user interface -----------------------------------------------------------------------------

log() { echo "$(date '+%T') $*" >> "$LOG"; }

say()
{
    LAST_SAY="$*"
    log "$*"
    echo "topsolinux: $*" >&2
    echo "$*" > "$DATA/.status"
    progress_send "# $*"
}

# a part of a step, with its own progress bar: SECONDS is how long it usually takes
part()  # SECONDS TEXT
{
    say "$2"
    progress_send "part $1"
}

# in a subshell: if the progress window has gone, the write kills only that
progress_send() { [ -n "$PROGRESS" ] && ( echo "$*" >&"$PROGFD" ) 2>/dev/null; }

fail()
{
    log "ERROR: $*"
    echo "topsolinux: error: $*" >&2
    [ -n "$PROGRESS" ] && { exec {PROGFD}>&-; wait "$PROGRESS" 2>/dev/null; PROGRESS=""; }
    # Wine's background services keep the AppImage in use; stop them so the installer can be replaced
    [ $UPDATE_APPIMAGE = 1 ] || "$WINESERVER" -k 2>/dev/null
    [ $GUI = 1 ] && zenity --error --width=460 --title="$TITLE" --window-icon="$ICON" \
        --text="<b>The installation stopped.</b>\n\n$*\n\nStart the installer again to continue where it stopped.\nDetails: $LOG"
    exit 1
}

info()  # TEXT [HEADING]
{
    if [ $GUI = 1 ]; then zenity --info --width=520 --title="$TITLE" --window-icon="$ICON" --text="$*"
    else printf '%b\n' "topsolinux: $*" | sed 's/<[^>]*>//g' >&2; fi
}

question()  # TEXT OK-LABEL CANCEL-LABEL
{
    zenity --question --width=520 --title="$TITLE" --window-icon="$ICON" --ok-label="$2" --cancel-label="$3" --text="$1"
}

progress_start()  # HEADING
{
    [ $GUI = 1 ] || return
    # a descriptor chosen by bash: a fixed one could be the AppImage runtime's keepalive pipe, and closing
    # that unmounts the AppImage
    if python3 "$TOOLS/progress.py" --check; then
        [ -n "$PROGRESS_SINCE" ] || PROGRESS_SINCE=$(date +%s)
        exec {PROGFD}> >(python3 "$TOOLS/progress.py" --title "$TITLE" --heading "$1" --icon "$HERE/topsolinux.png" \
                             --since "$PROGRESS_SINCE" 2>/dev/null
                         [ $? = 3 ] && cancel_requested)
    else
        # without GTK for Python: zenity's single pulsating bar, with the texts only
        exec {PROGFD}> >(grep --line-buffered '^#' | zenity --progress --pulsate --auto-close --width=520 --title="$TITLE" \
                             --window-icon="$ICON" --text="Preparing..." 2>/dev/null
                         [ $? = 1 ] && cancel_requested)
    fi
    PROGRESS=$!
    [ -n "$LAST_HEADING" ] && progress_send "$LAST_HEADING"
    [ -n "$LAST_TOTAL" ] && progress_send "$LAST_TOTAL"
}

# Cancel in the progress dialog (runs next to the installer): stop the installer and everything it runs
cancel_requested()
{
    kill -TERM $$
    stop_children $$
}

stop_children()  # PID
{
    local p
    for p in $(pgrep -P "$1"); do
        [ "$p" = "$BASHPID" ] && continue
        stop_children "$p"
        kill -TERM "$p" 2>/dev/null
    done
}

cancelled()
{
    trap - TERM
    log "cancelled"
    [ -n "$PROGRESS" ] && { exec {PROGFD}>&-; PROGRESS=""; }
    rm -rf "$DATA/appimage-build" ${PART:+"$PART"}
    if [ $UPDATE_APPIMAGE = 1 ]; then
        info "Cancelled. The TopSolid AppImage was not changed."
    else
        "$WINESERVER" -k 2>/dev/null
        info "<b>The installation was cancelled.</b>\n\nStart the installer again to continue where it stopped."
    fi
    exit 1
}
trap cancelled TERM

progress_stop()
{
    [ -n "$PROGRESS" ] || return
    exec {PROGFD}>&-
    wait "$PROGRESS" 2>/dev/null
    PROGRESS=""
}

# how long a step usually takes in seconds, for the progress bars (a fast computer takes about half)
step_seconds()
{
    case "$1" in
        download) echo 1500 ;; prefix) echo 60 ;; runtimes) echo 420 ;; setup) echo 300 ;; sqlsetup) echo 150 ;;
        extras) echo 15 ;; sql) echo 360 ;; pdm) echo 90 ;; finish) echo 15 ;; spacemouse) echo 40 ;;
        appimage) echo 300 ;; gearlever) echo 60 ;; *) echo 60 ;;
    esac
}

# the phase a step belongs to, shown as the progress window's heading
step_heading()
{
    case "$1" in
        download) echo "Downloading TopSolid" ;;
        prefix|runtimes) echo "Preparing Windows (Wine, .NET, Visual C++)" ;;
        sqlsetup|sql) echo "Setting up SQL Server" ;;
        pdm) echo "Setting up the local PDM" ;;
        appimage) echo "Making the TopSolid AppImage" ;;
        gearlever) echo "Adding TopSolid to the app menu" ;;
        *) echo "Installing TopSolid" ;;
    esac
}

# where a step of $PLAN starts and ends on the total progress bar: FROM TO SECONDS
step_range()
{
    local s secs all=0 before=0 mine=0
    for s in $PLAN; do
        secs=$(step_seconds "$s")
        [ "$s" = "$1" ] && mine=$secs
        [ "$mine" = 0 ] && before=$((before + secs))
        all=$((all + secs))
    done
    echo "$((before * 100 / all)) $(((before + mine) * 100 / all)) $mine"
}

# run a step only once, so that an interrupted installation continues where it stopped
step()
{
    grep -qx "$1" "$STATE" 2>/dev/null && return
    LAST_HEADING="heading $(step_heading "$1")"
    LAST_TOTAL="total $(step_range "$1")"
    progress_send "$LAST_HEADING"
    progress_send "$LAST_TOTAL"
    progress_send "part $(step_seconds "$1")"
    "step_$1" || fail "${LAST_SAY:-Step $1 failed.}"
    echo "$1" >> "$STATE"
}

# --- Wine helpers --------------------------------------------------------------------------------

wine_run() { log "wine $*"; "$WINE" "$@" >> "$LOG" 2>&1; }

winpath() { "$WINE" winepath -w "$1" 2>/dev/null; }

# import a .reg file the way regedit reads it most reliably: UTF-16 with CRLF
reg_import()
{
    local tmp="$WINEPREFIX/drive_c/topsolinux-import.reg"
    { printf '\xff\xfe'; sed 's/$/\r/' "$1" | iconv -f utf-8 -t utf-16le; } > "$tmp"
    wine_run regedit /S 'C:\topsolinux-import.reg'
    rm -f "$tmp"
}

sql_wait_ready()
{
    local errlog="$SQLDIR/Log/ERRORLOG" i
    for i in $(seq 90); do
        if [ -f "$errlog" ] && iconv -f utf-16 -t utf-8 "$errlog" 2>/dev/null | grep -q -i 'ready for client'; then
            return 0
        fi
        if [ -f "$errlog" ] && iconv -f utf-16 -t utf-8 "$errlog" 2>/dev/null | grep -q -i 'shutting down'; then
            return 1
        fi
        sleep 2
    done
    return 1
}

# draw Windows programs at the desktop's scale; Wine assumes 100% otherwise
set_dpi() { wine_run reg add 'HKCU\Control Panel\Desktop' /v LogPixels /t REG_DWORD /d "$("$TOOLS/desktop-dpi")" /f; }

sql_query() { "$WINE" "$OSQL" -S 'np:\\.\pipe\SQLLocal\SQLTOPSOLID' -E "$@" 2>>"$LOG"; }

find_version()
{
    local d
    d="$(ls -d "$WINEPREFIX/drive_c/Program Files/TOPSOLID/TopSolid 7."* 2>/dev/null | sort -V | tail -1)"
    VERSION="${d##*TopSolid }"
    [ -n "$VERSION" ] || return 1
    TSBIN="$d/bin"
    PDM_SERVICE="TopSolid'Local Pdm Server $VERSION"
}

service_exists() { "$WINE" sc query "$1" 2>/dev/null | grep -q STATE; }

service_state() { "$WINE" sc query "$1" 2>/dev/null | tr -d '\r' | sed -n 's/.*STATE *: *[0-9]* *\([A-Z_]*\).*/\1/p'; }

# stop a service and wait until it has really stopped
stop_service()
{
    local i
    wine_run net stop "$1"
    for i in $(seq 30); do
        case "$(service_state "$1")" in STOPPED|"") return 0 ;; esac
        sleep 2
    done
    return 1
}

# TopSolid's PDM service starts SQL Server when Wine starts; SQL Server must be stopped to reconfigure it
stop_sql()
{
    find_version && stop_service "$PDM_SERVICE"
    stop_service 'MSSQL$SQLTOPSOLID'
}

# the PDM database: none, incomplete (tables without their keys yet) or complete
pdm_db_state()
{
    sql_query -h-1 -Q "set nocount on; if db_id('LocalPdmServer') is null select 'db-none'
        else if exists (select 1 from LocalPdmServer.sys.tables) and not exists (select 1 from LocalPdmServer.sys.tables t
            where not exists (select 1 from LocalPdmServer.sys.indexes i where i.object_id = t.object_id and i.is_primary_key = 1))
        select 'db-complete' else select 'db-incomplete'" | tr -d '\r' | grep -o -m1 'db-[a-z]*'
}

stop_services()
{
    find_version && wine_run net stop "$PDM_SERVICE"
    wine_run net stop 'MSSQL$SQLTOPSOLID'
    wine_run net stop "Sentinel RMS License Manager"
    "$WINESERVER" -k 2>/dev/null
    "$WINESERVER" -w 2>/dev/null
}

# --- installation steps --------------------------------------------------------------------------

# the same public server and file list as TopSolid.Downloader.exe on the installation media
step_download()
{
    say "Downloading TopSolid from TopSolid's server"
    python3 "$TOOLS/fetchmedia.py" "$MEDIA" 2>>"$LOG" | while IFS= read -r line; do
        case "$line" in
            "#"*) [ -n "$PROGRESS" ] && progress_send "$line" || echo "$line" >&2 ;;
            [0-9]*) progress_send "$line" ;;
        esac
    done
    [ "${PIPESTATUS[0]}" = 0 ] || { say "Downloading TopSolid failed"; return 1; }
    check_media "$MEDIA"
}

# Wine links the Windows desktop to the Linux one; TopSolid's setup would then put .lnk files there
unlink_desktop()
{
    local d="$WINEPREFIX/drive_c/users/${USER:-$(id -un)}/Desktop" target
    [ -L "$d" ] || return 0
    target="$(readlink -f "$d")"
    rm -f "$target"/TopSolid*.lnk "$target"/"SQL Server"*.lnk 2>/dev/null
    rm -f "$d" && mkdir -p "$d"
}

step_prefix()
{
    say "Preparing the Windows environment"
    # Wine installs Gecko (for embedded web pages) without asking when it is in its download cache;
    # Mono is not needed, .NET comes from the installation media
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/wine" arch v
    v="$(sed -n 's/.*GECKO_VERSION *"\([0-9.]*\)".*/\1/p' "$SHARE/wine-addons" 2>/dev/null)"
    mkdir -p "$cache"
    for arch in x86 x86_64; do
        [ -n "$v" ] && [ ! -f "$cache/wine-gecko-$v-$arch.msi" ] &&
            wget -q -O "$cache/wine-gecko-$v-$arch.msi" "https://dl.winehq.org/wine/wine-gecko/$v/wine-gecko-$v-$arch.msi"
    done
    WINEDLLOVERRIDES="$WINEDLLOVERRIDES;mscoree=" wine_run wineboot -i
    unlink_desktop
    # no Windows file associations or menu entries on the Linux desktop, also when an installer (or winetricks)
    # replaces WINEDLLOVERRIDES
    wine_run reg add 'HKCU\Software\Wine\DllOverrides' /v winemenubuilder.exe /d "" /f
    # installers of Microsoft's runtimes crash in helper tools (e.g. ServiceModelReg.exe); without this,
    # Wine's crash dialog stops the installation until someone closes it
    wine_run reg add 'HKCU\Software\Wine\WineDbg' /v ShowCrashDialog /t REG_DWORD /d 0 /f
    set_dpi
    "$WINESERVER" -w
    [ -f "$WINEPREFIX/system.reg" ]
}

winetricks_run() { WINETRICKS_LATEST_VERSION_CHECK=disabled winetricks --unattended "$@" >> "$LOG" 2>&1; }

step_runtimes()
{
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/winetricks" ndp="$MEDIA/Setup/Redist/dotnet/NDP48-x86-x64-AllOS-ENU.exe"
    local sp1="$MEDIA/Setup/Redist/dotnet/dotnetfx35-SP1.exe"
    # .NET 4.0 is only needed for its mscoree.dll, which the .NET 4.8 installer expects Windows to have
    part 150 "Installing fonts, Visual C++ and .NET 4.0"
    winetricks_run corefonts vcrun2019 dotnet40 || { say "Installing fonts, Visual C++ and .NET 4.0 failed"; return 1; }

    part 120 "Installing .NET Framework 4.8 from the installation media"
    if [ -f "$ndp" ]; then
        wine_run winecfg /v win7
        WINEDLLOVERRIDES="$WINEDLLOVERRIDES;fusion=b" wine_run "$(winpath "$ndp")" /q /norestart
        "$WINESERVER" -w
        wine_run reg add 'HKCU\Software\Wine\DllOverrides' /v mscoree /d native /f
    else
        winetricks_run dotnet48
    fi
    "$WINE" reg query 'HKLM\Software\Microsoft\NET Framework Setup\NDP\v4\Full' /v Release 2>/dev/null | grep -q Release ||
        { say "Installing .NET Framework 4.8 failed"; return 1; }

    # SQL Server's CLR Types need .NET 3.5 before TopSolid's setup runs; winetricks takes the media's copy
    part 150 "Installing .NET Framework 3.5 from the installation media"
    if [ -f "$sp1" ] && [ "$(sha256sum < "$sp1" | cut -d' ' -f1)" = 0582515bde321e072f8673e829e175ed2e7a53e803127c50253af76528e66bc1 ]; then
        mkdir -p "$cache/dotnet35sp1"
        [ -f "$cache/dotnet35sp1/dotnetfx35.exe" ] || cp "$sp1" "$cache/dotnet35sp1/dotnetfx35.exe"
    fi
    winetricks_run dotnet35sp1 || { say "Installing .NET Framework 3.5 failed"; return 1; }
    wine_run winecfg /v win10
    "$WINESERVER" -w
}

# TopSolid's setup runs SQL Server's setup, which fails or waits on a dialog that doesn't respond under
# Wine; stop it as soon as it starts (only Wine processes, whose command lines start with a drive letter)
stop_sql_setups()
{
    while kill -0 $$ 2>/dev/null && sleep 1; do
        pkill -u "$(id -u)" -i -f '^[a-z]:\\.*(\\SQL Server Express\\|\\Setup Bootstrap\\SQL2019\\)' &&
            log "stopped the SQL Server setup that TopSolid's setup started"
    done
}

step_setup()
{
    progress_stop
    set_dpi
    info "<b>Now TopSolid's own installer opens.</b>

1. Choose the modules you use, click <b>Install</b> and accept the license agreement.
2. <span foreground='#c01c28'><b>It reports \"Failed to install this component: Microsoft SQL Server 2019 Express\". That is expected.</b></span>
    $NAME stops SQL Server's own setup, which doesn't work under Wine, and installs SQL Server itself afterwards.
    Click <b>OK</b>, close the log window if one opens, and click <b>Close</b>."
    log "running $MEDIA/Setup.exe"
    stop_sql_setups &
    local stopper=$!
    (cd "$MEDIA" && "$WINE" Setup.exe >> "$LOG" 2>&1)
    kill "$stopper" 2>/dev/null
    # the bootstrapper may leave msiexec or the SQL setup running for a moment
    local i
    for i in $(seq 60); do
        pgrep -u "$(id -u)" -f -i 'msiexec|SQL Server Express.SETUP|SETUP.EXE' >/dev/null || break
        sleep 5
    done
    progress_start "Installing TopSolid"
    find_version || { say "TopSolid's setup was closed before TopSolid was installed."; return 1; }
    say "TopSolid $VERSION installed"
}

# TopSolid's setup starts SQL Server's setup with update checking, which fails right away under Wine (no Windows
# Update). Run it again the same way without that; it then gets as far as installing SQL Server and fails only in
# the final configuration (WMI), which step_sql finishes.
step_sqlsetup()
{
    local setup="$MEDIA/Setup/Redist/SQL Server Express/SETUP.EXE"
    [ -f "$SQLDIR/Binn/sqlservr.exe" ] && return 0
    [ -f "$setup" ] || { say "SQL Server Express is not on the installation media"; return 1; }
    say "Installing SQL Server Express from the installation media"
    # quiet, without the progress window in which its setup engine once died on an Xlib race; a second run
    # continues if it stops anyway
    local try i
    for try in 1 2; do
        [ $try = 2 ] && part 120 "Installing SQL Server Express again (its setup stopped)"
        (cd "$(dirname "$setup")" && "$WINE" SETUP.EXE /Q /ENU /ACTION=Install /FEATURES=SQLENGINE /INSTANCENAME=SQLTOPSOLID \
            /UPDATEENABLED=False /IACCEPTSQLSERVERLICENSETERMS /SUPPRESSPRIVACYSTATEMENTNOTICE \
            "/SQLSVCACCOUNT=NT AUTHORITY\NETWORK SERVICE" "/SQLSYSADMINACCOUNTS=BUILTIN\Administrators" \
            /TCPENABLED=1 /NPENABLED=1 /SQLCOLLATION=SQL_Latin1_General_CP1_CI_AS /BROWSERSVCSTARTUPTYPE=Disabled >> "$LOG" 2>&1)
        # the setup engine keeps running for a while after SETUP.EXE has returned
        for i in $(seq 240); do
            pgrep -u "$(id -u)" -f -i 'ScenarioEngine|SQL Server Express.SETUP' >/dev/null || break
            sleep 5
        done
        [ -f "$SQLDIR/Binn/sqlservr.exe" ] && return 0
    done
    say "SQL Server Express could not be installed"
    return 1
}

step_extras()
{
    local m
    m="$(ls "$MEDIA"/Setup/Redist/Sentinel\ RMS\ License\ Manager/*.msi 2>/dev/null | head -1)"
    # after a failing SQL Server setup the bootstrapper skips the rest
    if [ ! -f "$WINEPREFIX/drive_c/Program Files (x86)/Common Files/Thales/Sentinel RMS License Manager/WinNT/lservnt.exe" ]; then
        [ -n "$m" ] && { say "Installing the license server"; wine_run msiexec /i "$(winpath "$m")" /qn; }
    fi
    # the license server's MSI sets up Sentinel RMS's persistence, which TopSolid's 30-day evaluation needs on its
    # very first start; it is sometimes missing afterwards, a repair of the MSI creates it
    if [ -n "$m" ] && [ ! -d "$RMS_PERSISTENCE" ]; then
        say "Repairing the license server"
        wine_run msiexec /fa "$(winpath "$m")" /qn
        [ -d "$RMS_PERSISTENCE" ] || { say "The license server could not be set up"; return 1; }
    fi
    if [ ! -f "$WINEPREFIX/drive_c/Program Files/TOPSOLID/TopSolid Update/bin/TopSolid.Update.exe" ]; then
        m="$(ls "$MEDIA"/Setup/x64/TopSolid\'Update\ x64.msi 2>/dev/null | head -1)"
        [ -n "$m" ] && { say "Installing TopSolid'Update"; wine_run msiexec /i "$(winpath "$m")" /qn; }
    fi
    return 0
}

sql_healthy()
{
    local i
    service_exists 'MSSQL$SQLTOPSOLID' || return 1
    if [ "$(service_state 'MSSQL$SQLTOPSOLID')" != RUNNING ]; then
        rm -f "$SQLDIR/Log/ERRORLOG"
        wine_run net start 'MSSQL$SQLTOPSOLID'
        sql_wait_ready || return 1
    fi
    for i in 1 2 3; do
        sql_query -h-1 -Q "set nocount on; select 'topsolinux-ok'" | grep -q topsolinux-ok && return 0
        sleep 5
    done
    return 1
}

# SQL Server's setup fails under Wine near the end (WMI), leaving the instance unconfigured. Finish it by hand:
# registry, system databases from the templates, their file locations and a login for the Windows admin group.
step_sql()
{
    say "Setting up SQL Server"
    [ -f "$SQLDIR/Binn/sqlservr.exe" ] || { say "SQL Server Express is not installed"; return 1; }
    # leftovers of an interrupted configuration
    local f
    for f in 3 4 5; do wine_run reg delete "$SQLPARAMS" /v SQLArg$f /f; done
    rm -f "$SQLDIR/Log/ERRORLOG"
    # only test an instance that was configured before: the unconfigured one cannot start
    if [ -f "$SQLDIR/DATA/.topsolinux" ] && sql_healthy; then return 0; fi

    stop_sql
    reg_import "$SHARE/reg/sql-instance.reg"
    reg_import "$SHARE/reg/services.reg"
    # services.exe only reads new services when it starts
    "$WINESERVER" -k; "$WINESERVER" -w
    wine_run wineboot
    service_exists 'MSSQL$SQLTOPSOLID' || { say "The SQL Server service could not be created"; return 1; }
    stop_sql || { say "SQL Server could not be stopped"; return 1; }
    mkdir -p "$SQLDIR/DATA" "$SQLDIR/Log" "$SQLDIR/Backup" "$SQLDIR/JOBS"
    for f in master.mdf mastlog.ldf model.mdf modellog.ldf msdbdata.mdf msdblog.ldf; do
        [ -f "$SQLDIR/DATA/$f" ] || cp "$SQLDIR/Binn/Templates/$f" "$SQLDIR/DATA/" || return 1
    done

    # a normal start moves the resource database's location in master from Microsoft's build folder to Binn;
    # it then stops because model is still in the build folder too, which is fine
    rm -f "$SQLDIR/Log/ERRORLOG"
    wine_run net start 'MSSQL$SQLTOPSOLID'
    sql_wait_ready
    stop_service 'MSSQL$SQLTOPSOLID'

    # single user, minimal configuration, only master: move the other system databases and add the admin login
    wine_run reg add 'HKLM\SOFTWARE\Microsoft\Microsoft SQL Server\MSSQL15.SQLTOPSOLID\MSSQLServer\SuperSocketNetLib\Tcp' /v Enabled /t REG_DWORD /d 0 /f
    wine_run reg add "$SQLPARAMS" /v SQLArg3 /d -m /f
    wine_run reg add "$SQLPARAMS" /v SQLArg4 /d -f /f
    wine_run reg add "$SQLPARAMS" /v SQLArg5 /d -T3608 /f
    rm -f "$SQLDIR/Log/ERRORLOG"
    wine_run net start 'MSSQL$SQLTOPSOLID'
    sql_wait_ready || { say "SQL Server did not start"; return 1; }
    cp "$SHARE/sql/firstconfig.sql" "$SHARE/sql/logins.sql" "$WINEPREFIX/drive_c/"
    local out
    out="$(sql_query -n -i 'C:\firstconfig.sql'; sql_query -n -i 'C:\logins.sql')"
    echo "$out" >> "$LOG"
    rm -f "$WINEPREFIX/drive_c/firstconfig.sql" "$WINEPREFIX/drive_c/logins.sql"
    if echo "$out" | grep -q "^Msg "; then say "Setting up SQL Server's databases failed"; return 1; fi
    stop_service 'MSSQL$SQLTOPSOLID'
    for f in 3 4 5; do wine_run reg delete "$SQLPARAMS" /v SQLArg$f /f; done

    # normal start: TCP on port 14330 (the PDM uses it), automatic start
    reg_import "$SHARE/reg/tweaks.reg"
    rm -f "$SQLDIR/Log/ERRORLOG"
    sql_healthy || { say "SQL Server does not work after setting it up"; return 1; }
    touch "$SQLDIR/DATA/.topsolinux"
}

# The local PDM refuses its first start unless TopSolid's PDM server admin tool is running
step_pdm()
{
    local i state
    find_version || return 1
    reg_import "$SHARE/reg/tweaks.reg"
    say "First start of the local PDM server"
    stop_service "$PDM_SERVICE"
    wine_run net start 'MSSQL$SQLTOPSOLID'
    # an interrupted first start leaves a database without keys, which the PDM never completes: start over
    if [ "$(pdm_db_state)" = db-incomplete ]; then
        log "incomplete PDM database, creating it again"
        sql_query -Q "alter database LocalPdmServer set single_user with rollback immediate; drop database LocalPdmServer" >> "$LOG"
        rm -rf "$WINEPREFIX/drive_c/ProgramData/TOPSOLID/TopSolid'Local Pdm Server Service"
    fi
    (cd "$TSBIN" && "$WINE" TopSolid.Pdm.ServerServiceAdmin.exe >> "$LOG" 2>&1 &)
    sleep 15
    # the service creates its database only when started while the admin runs; it may have started already
    stop_service "$PDM_SERVICE"
    wine_run net start "$PDM_SERVICE"
    # the service reports running before its database is complete; stopping it then leaves the database broken
    for i in $(seq 100); do
        state="$(pdm_db_state)"
        [ "$state" = db-complete ] && break
        sleep 3
    done
    wine_run taskkill /f /im TopSolid.Pdm.ServerServiceAdmin.exe
    log "PDM database: $state"
    [ "$state" = db-complete ] || { say "The local PDM server did not create its database"; return 1; }
}

step_finish()
{
    find_version || return 1
    say "Finishing the installation"
    python3 "$TOOLS/exeicon.py" "$TSBIN/TopSolid.exe" "$DATA/topsolid.png" >> "$LOG" 2>&1 || cp "$HERE/topsolinux.png" "$DATA/topsolid.png"
    # the server side of the local PDM was started for the first time in step_pdm; without this flag TopSolid does
    # that again on its first connection, stopping and restarting the service, which fails ("Unable to start service")
    local conf="$WINEPREFIX/drive_c/users/${USER:-$(id -un)}/AppData/Roaming/TOPSOLID/TopSolid/$VERSION/TopSolid/Kernel/SX"
    mkdir -p "$conf"
    python3 "$TOOLS/userconfig.py" "$conf/Config.ConfigData.xml" TopSolid/Pdm/UI/Connections/ConnectionDialog \
        HasLocalPdmAlreadyStarted Bool True >> "$LOG" 2>&1 || { say "Setting up TopSolid's PDM connection failed"; return 1; }
    touch "$WINEPREFIX/.topsolinux"
    unlink_desktop
    wine_run reg delete 'HKCU\Software\Wine\WineDbg' /v ShowCrashDialog /f
    stop_services
}

# 3Dconnexion devices: vendor 256f, or Logitech's old 046d:c6xx
spacemouse_present()
{
    local d
    for d in /sys/bus/usb/devices/*; do
        [ -f "$d/idVendor" ] || continue
        case "$(cat "$d/idVendor"):$(cat "$d/idProduct" 2>/dev/null)" in 256f:*|046d:c6*) return 0 ;; esac
    done
    return 1
}

# the command that installs a distribution package, run as root
package_install_command()
{
    if command -v apt-get >/dev/null; then echo "apt-get install -y $*"
    elif command -v dnf >/dev/null; then echo "dnf install -y $*"
    elif command -v zypper >/dev/null; then echo "zypper --non-interactive install $*"
    elif command -v pacman >/dev/null; then echo "pacman -S --noconfirm $*"
    fi
}

# TopSolid's SpaceMouse support goes through spacenavd (see tdxnavlib in wine/patches)
step_spacemouse()
{
    local cmd
    command -v spacenavd >/dev/null || [ -x /usr/sbin/spacenavd ] || [ -x /usr/bin/spacenavd ] && return 0
    cmd="$(package_install_command spacenavd)"
    if [ -n "$cmd" ] && command -v pkexec >/dev/null; then
        say "Installing SpaceMouse support (asks for your password)"
        pkexec sh -c "$cmd && systemctl enable --now spacenavd" >> "$LOG" 2>&1 && return 0
    fi
    NOTES="$NOTES\n• SpaceMouse: install and start spacenavd yourself (for example <tt>sudo apt install spacenavd</tt>)."
    return 0
}

desktop_file()
{
    cat <<EOF
[Desktop Entry]
Type=Application
Name=TopSolid $VERSION
Comment=TopSolid $VERSION with its local PDM ($NAME)
Exec=AppRun
Icon=topsolid
Categories=Graphics;Engineering;
Terminal=false
StartupWMClass=topsolid.exe
Actions=update;license;winecfg;stop;

[Desktop Action update]
Name=TopSolid'Update
Exec=AppRun update

[Desktop Action license]
Name=TopSolid license
Exec=AppRun license-tool

[Desktop Action winecfg]
Name=Wine settings (screen scaling, ...)
Exec=AppRun winecfg

[Desktop Action stop]
Name=Stop background services
Exec=AppRun stop
EOF
}

# Wine, the starter and its tools: what a TopSolid AppImage runs, next to the installation in prefix/
appdir_runtime()
{
    local dir="$1"
    rm -rf "$dir/usr" "$dir/AppRun"
    mkdir -p "$dir/usr/lib/topsolinux"
    cp -al "$HERE/usr/bin" "$HERE/usr/share" "$dir/usr/" 2>/dev/null || cp -a "$HERE/usr/bin" "$HERE/usr/share" "$dir/usr/"
    cp -a "$HERE/usr/lib/wine" "$HERE/usr/lib/ntlm_auth" "$dir/usr/lib/"
    rm -rf "$dir/usr/share/topsolinux"
    cp "$TOOLS/unstick.exe" "$TOOLS/desktop-dpi" "$dir/usr/lib/topsolinux/"
    [ -d "$TOOLS/clrstack" ] && cp -a "$TOOLS/clrstack" "$dir/usr/lib/topsolinux/"
    mkdir -p "$dir/usr/share/doc/topsolinux" && echo "$TSL_VERSION" > "$dir/usr/share/doc/topsolinux/VERSION"
    cp "$HERE/topsolinux-run" "$dir/AppRun"
}

# TopSolid's own icon, or this installer's; as PNG, which file managers and Gear Lever show
app_icon()  # APPDIR
{
    rm -f "$1/topsolid.svg" "$1/.DirIcon"
    cp "$DATA/topsolid.png" "$1/topsolid.png" 2>/dev/null || cp "$HERE/topsolinux.png" "$1/topsolid.png"
    ln -s topsolid.png "$1/.DirIcon"
}

# the name of a TopSolid AppImage shows the TopSo'Linux version that made it
versioned_name()  # PATH
{
    local dir="${1%/*}" base="${1##*/}"
    base="$(printf %s "$base" | sed -E 's/[-_]topsolinux[-_]([0-9]+(\.[0-9]+)*|dev)//I')"
    case "$base" in
        *-x86_64.*) base="${base/-x86_64./-TopSoLinux-$TSL_VERSION-x86_64.}" ;;
        *.*) base="${base%.*}_topsolinux-$TSL_VERSION.${base##*.}" ;;
        *) base="${base}_topsolinux-$TSL_VERSION" ;;
    esac
    echo "$dir/$base"
}

# the app menu entries that start OLD start NEW
retarget_desktop_files()  # OLD NEW
{
    local f o n
    o="$(printf %s "$1" | sed 's/[][\/.*^$&]/\\&/g')"
    n="$(printf %s "$2" | sed 's/[\/&]/\\&/g')"
    grep -lsF --null "$1" "$HOME/.local/share/applications/"*.desktop |
        while IFS= read -r -d '' f; do sed -i "s/$o/$n/g" "$f"; done
}

# the TopSolid AppImage of this installation: where it was made, or where Gear Lever put it
find_topsolid_appimage()
{
    local f
    for f in "$(cat "$DATA/appimage.path" 2>/dev/null)" \
             $(grep -lis topsolid "$HOME/.local/share/applications/"*.desktop | xargs -r grep -ohiE '/[^ "]*\.appimage' 2>/dev/null); do
        [ -f "$f" ] && "$f" --appimage-offset >/dev/null 2>&1 && { echo "$f"; return; }
    done
}

# A TopSolid AppImage made by an earlier version gets this version's Wine, starter and tools. The
# installation in it stays as it was made: nothing of this computer's TopSolid or projects gets into it.
update_appimage()  # FILE
{
    local old="$1" new build="$DATA/appimage-build" need free
    new="$(versioned_name "$old")"
    need=$(( $(stat -c %s "$old") * 3 / 1024 / 1024 / 1024 + 2 ))
    free=$(( $(df -Pk "$DATA" | awk 'NR == 2 { print $4 }') / 1024 / 1024 ))
    [ "$free" -ge "$need" ] || fail "Updating the TopSolid AppImage needs $need GB of free disk space in $DATA, there is $free GB."
    LAST_TOTAL="total 0 100 240"
    progress_send "$LAST_TOTAL"
    part 60 "Unpacking the TopSolid AppImage"
    rm -rf "$build"
    mkdir -p "$build"
    (cd "$build" && "$old" --appimage-extract >> "$LOG" 2>&1) || fail "Unpacking $old failed."
    [ -d "$build/squashfs-root/prefix" ] || { rm -rf "$build"; fail "$old is not a TopSolid AppImage made by $NAME."; }
    appdir_runtime "$build/squashfs-root"
    # older ones may have an SVG icon, which file managers don't show
    [ -f "$build/squashfs-root/topsolid.png" ] || app_icon "$build/squashfs-root"
    part 180 "Making the TopSolid AppImage with $NAME $TSL_VERSION"
    PART="$new.part"
    ARCH=x86_64 APPIMAGE_EXTRACT_AND_RUN=1 "$TOOLS/appimagetool.AppImage" --comp zstd \
        --runtime-file "$TOOLS/runtime-x86_64" "$build/squashfs-root" "$new.part" >> "$LOG" 2>&1 ||
        { rm -rf "$build" "$new.part"; fail "Making the AppImage failed."; }
    # a running TopSolid keeps the old file until it is closed
    mv "$new.part" "$new" || fail "$new could not be written."
    PART=""
    rm -rf "$build"
    if [ "$new" != "$old" ]; then
        retarget_desktop_files "$old" "$new"
        rm -f "$old"
    fi
    echo "$new" > "$DATA/appimage.path"
    UPDATED="$new"
}

run_update_appimage()
{
    local old="${UPDATE_FROM:-$(find_topsolid_appimage)}"
    if [ -z "$old" ] && [ $GUI = 1 ]; then
        old="$(zenity --file-selection --title="Choose the TopSolid AppImage" --window-icon="$ICON" \
            --filename="$HOME/" --file-filter="AppImage | *.AppImage *.appimage")" || exit 0
    fi
    [ -f "$old" ] || fail "No TopSolid AppImage found; name it: $0 update-appimage FILE"
    echo "=== $(date '+%F %T') $TITLE, update $old" >> "$LOG"
    progress_start "Updating the TopSolid AppImage"
    update_appimage "$old"
    progress_stop
    info "<big><b>The TopSolid AppImage is updated</b></big>\n\n<tt>${UPDATED/#$HOME/\~}</tt> now has $NAME $TSL_VERSION. A TopSolid that is running keeps the old version until you close it."
}

# A self-contained AppImage of this installation, e.g. for colleagues with the same license.
# The copy uses hard links, so it takes no extra disk space and leaves the installation untouched;
# files that are changed in the copy are replaced, never edited in place.
step_appimage()
{
    local build="$DATA/appimage-build" user placeholder=__wineuser__ out
    local dir="$build/AppDir"
    find_version || return 1
    out="$(versioned_name "$APPIMAGE_DIR/TopSolid-$VERSION-x86_64.AppImage")"
    say "Making the TopSolid AppImage (10-20 minutes)"
    stop_services
    rm -rf "$build"
    appdir_runtime "$dir"
    app_icon "$dir"
    desktop_file > "$dir/topsolid.desktop"
    cp -al "$WINEPREFIX" "$dir/prefix"

    local p="$dir/prefix" c
    c="$p/drive_c"
    user="$(ls "$c/users" | grep -v -x -e Public | head -1)"
    rm -f "$p/.topsolinux" "$p/.pdm-wait"
    rm -rf "$c/Program Files/Microsoft SQL Server/MSSQL15.SQLTOPSOLID/MSSQL/Log/"*
    rm -rf "$c/users/$user/AppData/Local/Temp/"* "$c/windows/temp/"*
    rm -rf "$c/Program Files/Microsoft SQL Server/150/Setup Bootstrap/Log"
    rm -rf "$c/ProgramData/TOPSOLID/TopSolid'Update/Downloads"
    rm -f "$c/users/$user/AppData/Roaming/TOPSOLID/TopSolid/$VERSION/TopSolid.log"
    # every user brings their own license
    local lic="$c/Program Files (x86)/Common Files/Thales/Sentinel RMS License Manager/WinNT/lservrc"
    rm -f "$lic" && touch "$lic"
    # links into this machine's home and drives; Wine recreates the folder links for the new user
    find "$c/users/$user" -maxdepth 1 -type l -delete
    find "$p/dosdevices" -mindepth 1 -maxdepth 1 ! -name c: ! -name z: -delete
    # the user name is filled in on the first start (sed -i writes new files, the originals stay intact)
    mv "$c/users/$user" "$c/users/$placeholder"
    sed -i "s/$user/$placeholder/g" "$p"/*.reg
    grep -rlI --null "$user" "$c/users/$placeholder" "$c/ProgramData" 2>/dev/null |
        xargs -0 -r sed -i "s/$user/$placeholder/g"

    mkdir -p "$APPIMAGE_DIR"
    PART="$out.part"
    ARCH=x86_64 APPIMAGE_EXTRACT_AND_RUN=1 "$TOOLS/appimagetool.AppImage" --comp zstd \
        --runtime-file "$TOOLS/runtime-x86_64" "$dir" "$out.part" >> "$LOG" 2>&1 || { say "Making the AppImage failed"; return 1; }
    mv "$out.part" "$out"
    PART=""
    rm -rf "$build"
    APPIMAGE_OUT="$out"
    echo "$out" > "$DATA/appimage.path"
}

gearlever_installed() { flatpak info "$GEARLEVER" >/dev/null 2>&1; }

# Gear Lever puts the AppImage in its folder and adds it to the app menu; installed from Flathub when missing
step_gearlever()
{
    local cmd out
    [ -n "$APPIMAGE_OUT" ] || APPIMAGE_OUT="$(cat "$DATA/appimage.path" 2>/dev/null)"
    if ! gearlever_installed; then
        say "Installing Gear Lever (asks for your password if Flatpak is missing)"
        if ! command -v flatpak >/dev/null; then
            cmd="$(package_install_command flatpak)"
            [ -n "$cmd" ] && command -v pkexec >/dev/null && pkexec sh -c "$cmd" >> "$LOG" 2>&1
        fi
        if command -v flatpak >/dev/null; then
            flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo >> "$LOG" 2>&1
            flatpak install --user -y --noninteractive flathub "$GEARLEVER" >> "$LOG" 2>&1
        fi
    fi
    if gearlever_installed; then
        say "Adding TopSolid to the app menu with Gear Lever"
        out="$(flatpak run "$GEARLEVER" --integrate "$APPIMAGE_OUT" -y 2>&1)"
        echo "$out" >> "$LOG"
        INTEGRATED="$(echo "$out" | sed -n 's/^\(\/.*\) was integrated successfully.*/\1/p' | tail -1)"
        # Gear Lever names it after the app (topsolid_7.20.appimage); the TopSo'Linux version goes back in
        if [ -f "$INTEGRATED" ]; then
            out="$(versioned_name "$INTEGRATED")"
            if [ "$out" = "$INTEGRATED" ] || mv "$INTEGRATED" "$out"; then
                retarget_desktop_files "$INTEGRATED" "$out"
                APPIMAGE_OUT="$out"
                echo "$out" > "$DATA/appimage.path"
            fi
        fi
    fi
    if [ -z "$INTEGRATED" ]; then
        NOTES="$NOTES\n• Gear Lever could not add TopSolid to the app menu; open the AppImage with Gear Lever yourself."
    fi
    return 0
}

# --- checks and questions ------------------------------------------------------------------------

check_media()
{
    [ -f "$1/Setup.exe" ] && ls "$1"/Setup/x64/TopSolid*.msi >/dev/null 2>&1
}

find_media()
{
    local d
    for d in "$HOME"/Downloads/*/ "$HOME"/*/ /media/"$USER"/*/ /run/media/"$USER"/*/; do
        check_media "$d" && { echo "${d%/}"; return; }
    done
}

check_system()
{
    local free
    mkdir -p "$DATA" || fail "Cannot create $DATA."
    free=$(df -Pk "$DATA" | awk 'NR==2 {print int($4/1024/1024)}')
    [ "$free" -ge $NEED_GB ] || fail "Not enough disk space: $free GB free, $NEED_GB GB needed."
    command -v python3 >/dev/null || fail "python3 is needed."
    ldd --version 2>/dev/null | head -1 | awk '{v=$NF; split(v,a,"."); exit !(a[1]>2 || (a[1]==2 && a[2]>=38))}' ||
        fail "This Linux is too old: glibc 2.38 or newer is needed (Ubuntu 24.04, Debian 13, Fedora 39 or newer)."
    # Wine's NTLM needs Samba's ntlm_auth; a copy is included for systems without it
    ntlm_auth --version >/dev/null 2>&1 || export PATH="$HERE/usr/lib/ntlm_auth/bin:$PATH"
}

# stop what runs in an earlier installation and remove it
remove_installation()
{
    [ -d "$WINEPREFIX" ] && "$WINESERVER" -k 2>/dev/null
    rm -rf "$WINEPREFIX" "$STATE" "$DATA/appimage-build" "$DATA/appimage.path" "$DATA/topsolid.png"
}

# an existing or interrupted installation: replace, continue or stop
check_existing()
{
    [ -f "$STATE" ] || [ -d "$WINEPREFIX" ] || return 0
    if grep -qx finish "$STATE" 2>/dev/null; then
        if [ $REPLACE = 0 ]; then
            [ $GUI = 1 ] || { echo "TopSolid is already installed in $DATA; use --replace to install it again" >&2; exit 1; }
            local choice
            choice="$(zenity --question --width=560 --title="$TITLE" --window-icon="$ICON" \
                --text="<b>TopSolid is already installed with $NAME.</b>\n\n<b>Update the AppImage</b>: the TopSolid AppImage gets the Wine and starter of $NAME $TSL_VERSION. Your installation and projects stay.\n\n<b>Replace</b>: install TopSolid again. The installation, its local PDM and the projects in it are removed." \
                --ok-label="Update the AppImage" --cancel-label="Cancel" --extra-button="Replace")" && choice=update
            case "$choice" in
                update)  UPDATE_APPIMAGE=1; return ;;
                Replace) ;;
                *)       exit 0 ;;
            esac
        fi
        remove_installation
    elif [ $GUI = 1 ] && [ $REPLACE = 0 ]; then
        question "<b>An earlier installation was interrupted.</b>\n\nContinue where it stopped, or start again from the beginning?" \
            "Continue" "Start again" || remove_installation
    elif [ $REPLACE = 1 ]; then
        remove_installation
    fi
}

ask()
{
    question "<big><b>Install TopSolid on Linux</b></big>\n\n$NAME installs TopSolid with its local PDM server and SQL Server, and adds it to your app menu.\n\n<b>What you need</b>\n• TopSolid's installation media, or an internet connection to download them from TopSolid (19 GB)\n• $NEED_GB GB of free disk space (65 GB when downloading) and 30 to 60 minutes\n\n<small>$NAME is an unofficial project, not affiliated with TOPSOLID SAS.</small>" \
        "Next" "Cancel" || exit 0

    check_existing
    [ $UPDATE_APPIMAGE = 1 ] && return

    local guess choice
    guess="$(find_media)"
    while :; do
        # buttons instead of a list: a list needs scrolling on scaled displays
        if [ -n "$guess" ]; then
            choice="$(zenity --question --width=560 --title="$TITLE" --window-icon="$ICON" \
                --text="<b>TopSolid installation media</b>\n\nFound in <tt>${guess/#$HOME/\~}</tt>" \
                --ok-label="Use these media" --cancel-label="Cancel" \
                --extra-button="Choose another folder" --extra-button="Download from TopSolid")" && choice=use
        else
            choice="$(zenity --question --width=560 --title="$TITLE" --window-icon="$ICON" \
                --text="<b>TopSolid installation media</b>\n\nNo installation media found in your Downloads folder. Download them from TopSolid's server (19 GB), or choose the folder with TopSolid's Setup.exe." \
                --ok-label="Download from TopSolid" --cancel-label="Cancel" \
                --extra-button="Choose folder")" && choice=download
        fi
        case "$choice" in
            use) MEDIA="$guess"; break ;;
            "Download from TopSolid"|download)
                MEDIA="$HOME/Downloads/TopSolid-$(python3 "$TOOLS/fetchmedia.py" /nonexistent --version-only 2>/dev/null | tr ' ' _)" ||
                    { zenity --error --width=420 --title="$TITLE" --window-icon="$ICON" --text="TopSolid's download server cannot be reached."; continue; }
                DOWNLOAD=1
                NEED_GB=$((NEED_GB + 20))
                break ;;
            Choose*)
                MEDIA="$(zenity --file-selection --directory --title="TopSolid media" --window-icon="$ICON" \
                         --filename="${guess:-$HOME/Downloads}/")" || continue
                check_media "$MEDIA" && break
                zenity --error --width=420 --title="$TITLE" --window-icon="$ICON" \
                    --text="<b>This is not TopSolid's installation media.</b>\n\nChoose the folder that contains TopSolid's Setup.exe."
                ;;
            *) exit 0 ;;
        esac
    done

    local sm=FALSE
    spacemouse_present && sm=TRUE
    choice="$(zenity --list --checklist --width=620 --height=420 --title="$TITLE" --window-icon="$ICON" \
        --text="<b>Options</b>\n\n<b>Gear Lever</b> puts TopSolid in your app menu. Right-click its icon there for TopSolid'Update, the license tool, Wine settings (for example screen scaling) and stopping the background services." \
        --column="" --column="" --hide-header --separator="|" \
        TRUE "Add TopSolid to the app menu with Gear Lever (recommended)" \
        $sm "SpaceMouse support (installs spacenavd)")" || exit 0
    case "$choice" in *SpaceMouse*) SPACEMOUSE=1 ;; *) SPACEMOUSE=0 ;; esac
    case "$choice" in
        *"Gear Lever"*) USE_GEARLEVER=1 ;;
        *)
            USE_GEARLEVER=0
            APPIMAGE_DIR="$(zenity --file-selection --directory --title="Save AppImage in" --window-icon="$ICON" \
                            --filename="$DEFAULT_APPIMAGE_DIR/")" || exit 0 ;;
    esac
}

# --- main ----------------------------------------------------------------------------------------

DEFAULT_APPIMAGE_DIR="$HOME/Applications"
[ -d "$DEFAULT_APPIMAGE_DIR" ] || DEFAULT_APPIMAGE_DIR="$HOME/Downloads"

case "${1:-}" in
    install)
        shift
        while [ $# -gt 0 ]; do
            case "$1" in
                --media)         MEDIA="$(readlink -f "$2")"; shift ;;
                --download)      DOWNLOAD=1; MEDIA="$(readlink -f "$2")"; NEED_GB=$((NEED_GB + 20)); shift ;;
                --replace)       REPLACE=1 ;;
                --gearlever)     USE_GEARLEVER=1 ;;
                --appimage-dir)  APPIMAGE_DIR="$(readlink -f "$2")"; USE_GEARLEVER=0; shift ;;
                --spacemouse)    SPACEMOUSE=1 ;;
                --no-spacemouse) SPACEMOUSE=0 ;;
                *) echo "unknown option $1" >&2; exit 1 ;;
            esac
            shift
        done
        [ -n "$MEDIA" ] || MEDIA="$(find_media)"
        [ $DOWNLOAD = 1 ] || check_media "${MEDIA:-/nonexistent}" ||
            { echo "usage: $0 install --media DIR | --download DIR [--replace] [--gearlever | --appimage-dir DIR] [--spacemouse]" >&2; exit 1; }
        [ "$SPACEMOUSE" = auto ] && { spacemouse_present && SPACEMOUSE=1 || SPACEMOUSE=0; }
        [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v zenity >/dev/null && GUI=1
        mkdir -p "$DATA"
        check_existing
        ;;
    update-appimage)
        UPDATE_APPIMAGE=1
        [ -n "${2:-}" ] && UPDATE_FROM="$(readlink -f "$2")"
        [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v zenity >/dev/null && GUI=1
        mkdir -p "$DATA"
        ;;
    "")
        [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v zenity >/dev/null ||
            { echo "no display or zenity; use: $0 install --media DIR" >&2; exit 1; }
        GUI=1
        mkdir -p "$DATA"
        ask
        ;;
    *)
        echo "usage: $0 [install --media DIR | --download DIR [--replace] [--gearlever | --appimage-dir DIR] [--spacemouse | --no-spacemouse]]" >&2
        echo "       $0 update-appimage [FILE]" >&2
        exit 1 ;;
esac
# with Gear Lever the AppImage is made in Downloads, Gear Lever then moves it to its own folder
[ $USE_GEARLEVER = 1 ] && APPIMAGE_DIR="$HOME/Downloads"
[ -n "$APPIMAGE_DIR" ] || APPIMAGE_DIR="$DEFAULT_APPIMAGE_DIR"

check_system
[ $UPDATE_APPIMAGE = 1 ] && { run_update_appimage; exit 0; }
echo "=== $(date '+%F %T') $TITLE, media $MEDIA, gearlever $USE_GEARLEVER, appimage $APPIMAGE_DIR" >> "$LOG"

PLAN="prefix runtimes setup sqlsetup extras sql pdm finish appimage"
[ $DOWNLOAD = 1 ] && PLAN="download $PLAN"
[ "$SPACEMOUSE" = 1 ] && PLAN="${PLAN/appimage/spacemouse appimage}"
[ $USE_GEARLEVER = 1 ] && PLAN="$PLAN gearlever"
progress_start "Installing TopSolid"
[ $DOWNLOAD = 1 ] && step download
step prefix
step runtimes
step setup
step sqlsetup
step extras
step sql
step pdm
step finish
[ "$SPACEMOUSE" = 1 ] && step spacemouse
step appimage
[ $USE_GEARLEVER = 1 ] && step gearlever
progress_stop
[ -n "$APPIMAGE_OUT" ] || APPIMAGE_OUT="$(cat "$DATA/appimage.path" 2>/dev/null)"

if [ -n "$INTEGRATED" ]; then
    where="TopSolid $VERSION is in your app menu. Right-click its icon for TopSolid'Update, the license tool, Wine settings and stopping the background services."
else
    where="Start TopSolid with <tt>${APPIMAGE_OUT/#$HOME/\~}</tt>."
fi
info "<big><b>TopSolid $VERSION is installed</b></big>\n\n$where\n\n<b>First start</b>\n• License: without a license file TopSolid starts its 30-day evaluation.\n• PDM connection: choose <i>Local PDM Server</i> and leave user and password empty.\n• Add the libraries you need from TopSolid.\n\nWant TopSolid on another computer? Copy the TopSolid AppImage there and start it (each computer needs its own license).$NOTES"
